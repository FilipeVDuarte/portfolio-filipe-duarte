---
import Base from '../layouts/Base.astro';
---

<Base
  title="Design Kit — Filipe Duarte"
  description="Biblioteca de componentes visuais desenvolvidos para o portfólio de Filipe Duarte. Sistema Neo-Brutalista com tokens de cor, tipografia, sombras e componentes reutilizáveis."
  canonical="/kit.html"
  ogTitle="Design Kit — Filipe Duarte"
  ogDescription="Todos os componentes visuais do portfólio num lugar só."
>

<style>
  .kit-page { padding-top: 60px; }

  .kit-hero {
    padding: var(--space-16) 0 var(--space-12);
    border-bottom: var(--border-thick);
    background: var(--color-ink);
    color: var(--color-bg);
  }

  .kit-hero__label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-yellow);
    margin-bottom: var(--space-5);
  }

  .kit-hero__title {
    font-family: var(--font-display);
    font-size: var(--text-4xl);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: -0.04em;
    line-height: 1;
    margin-bottom: var(--space-6);
  }

  .kit-hero__desc {
    font-size: var(--text-base);
    color: rgba(255,255,255,0.6);
    max-width: 60ch;
    line-height: 1.7;
  }

  .kit-nav {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
    padding: var(--space-5) 0;
    border-bottom: var(--border-thick);
    background: var(--color-bg);
    position: sticky;
    top: 60px;
    z-index: 10;
  }

  .kit-nav a {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: var(--space-1) var(--space-3);
    border: var(--border);
    background: var(--color-bg);
    color: var(--color-muted);
    transition: var(--transition-fast);
  }

  .kit-nav a:hover {
    background: var(--color-yellow);
    color: var(--color-ink);
    box-shadow: var(--shadow-sm);
  }

  /* Seções */
  .kit-section {
    padding-block: var(--space-16);
    border-bottom: var(--border-thick);
  }

  .kit-section:last-child { border-bottom: 0; }

  .kit-section__header {
    margin-bottom: var(--space-10);
  }

  .kit-section__num {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-muted);
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
  }

  .kit-section__num::before {
    content: '';
    display: block;
    width: 2rem;
    height: 2px;
    background: var(--color-ink);
  }

  .kit-section__title {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }

  /* Blocos de preview */
  .kit-canvas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5);
    align-items: flex-start;
  }

  .kit-canvas--col {
    flex-direction: column;
    align-items: stretch;
  }

  .kit-canvas--grid-2 {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-5);
  }

  .kit-canvas--grid-3 {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-5);
  }

  @media (max-width: 768px) {
    .kit-canvas--grid-2,
    .kit-canvas--grid-3 { grid-template-columns: 1fr; }
  }

  .kit-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .kit-item__label {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-muted);
  }

  .kit-item__code {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    background: var(--color-ink);
    color: var(--color-yellow);
    padding: var(--space-1) var(--space-2);
    display: inline-block;
  }

  /* Tokens */
  .kit-color-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: var(--space-4);
  }

  .kit-color {
    border: var(--border);
    overflow: hidden;
  }

  .kit-color__swatch {
    height: 64px;
  }

  .kit-color__info {
    padding: var(--space-3);
    background: var(--color-bg);
  }

  .kit-color__name {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: -0.01em;
  }

  .kit-color__var {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    color: var(--color-muted);
    margin-top: 2px;
  }

  .kit-shadow-demo {
    border: var(--border-thick);
    background: var(--color-bg);
    padding: var(--space-6) var(--space-8);
    font-family: var(--font-display);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .kit-type-row {
    display: flex;
    align-items: baseline;
    gap: var(--space-5);
    padding: var(--space-4) 0;
    border-bottom: var(--border);
  }

  .kit-type-row:last-child { border-bottom: 0; }

  .kit-type-row__meta {
    width: 160px;
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    color: var(--color-muted);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .kit-separator {
    width: 100%;
    height: 2px;
    background: var(--color-ink);
    margin: var(--space-8) 0;
    opacity: 0.08;
  }

  /* Mockup de card sem imagem */
  .kit-proj-mock .proj-card__thumb {
    background: var(--color-ink);
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(255,255,255,0.15);
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: -0.04em;
  }

  .kit-dark-bg {
    background: var(--color-ink);
    padding: var(--space-8);
    border: var(--border-thick);
  }
</style>

<div class="kit-page">

  <!-- HERO -->
  <div class="kit-hero">
    <div class="container">
      <p class="kit-hero__label" data-en="Design System · Neo-Brutalism">Design System · Neo-Brutalismo</p>
      <h1 class="kit-hero__title">Design Kit</h1>
      <p class="kit-hero__desc" data-en="All the tokens, components and visual patterns built for this portfolio. System developed from scratch — no external frameworks. Pure CSS with variables.">
        Todos os tokens, componentes e padrões visuais construídos para esse portfólio.
        Sistema desenvolvido do zero — sem frameworks externos. CSS puro com variáveis.
      </p>
    </div>
  </div>

  <!-- NAV ÂNCORAS -->
  <div class="kit-nav">
    <div class="container" style="display:flex; gap: var(--space-2); flex-wrap: wrap;">
      <a href="#cores" data-en="Colors">Cores</a>
      <a href="#tipografia" data-en="Typography">Tipografia</a>
      <a href="#sombras" data-en="Shadows">Sombras</a>
      <a href="#tags">Tags</a>
      <a href="#botoes" data-en="Buttons">Botões</a>
      <a href="#chips">Chips</a>
      <a href="#cards">Cards</a>
      <a href="#timeline">Timeline</a>
      <a href="#quote">Pull-quote</a>
      <a href="#contato" data-en="Contact">Contato</a>
      <a href="#filtros" data-en="Filters">Filtros</a>
      <a href="#secoes" data-en="Sections">Seções</a>
    </div>
  </div>

  <!-- 01 CORES -->
  <section class="kit-section" id="cores">
    <div class="container">
      <div class="kit-section__header">
        <p class="kit-section__num">01</p>
        <h2 class="kit-section__title" data-en="Colors">Cores</h2>
      </div>

      <p class="kit-item__label" style="margin-bottom: var(--space-5);" data-en="Main palette (light mode)">Paleta principal (light mode)</p>
      <div class="kit-color-grid">
        <div class="kit-color">
          <div class="kit-color__swatch" style="background:#F2F0EF; border-bottom: 2px solid #1b1b1d;"></div>
          <div class="kit-color__info"><p class="kit-color__name">Background</p><p class="kit-color__var">--color-bg · #F2F0EF</p></div>
        </div>
        <div class="kit-color">
          <div class="kit-color__swatch" style="background:#1b1b1d;"></div>
          <div class="kit-color__info"><p class="kit-color__name">Ink</p><p class="kit-color__var">--color-ink · #1B1B1D</p></div>
        </div>
        <div class="kit-color">
          <div class="kit-color__swatch" style="background:#FFC300;"></div>
          <div class="kit-color__info"><p class="kit-color__name">Yellow</p><p class="kit-color__var">--color-yellow · #FFC300</p></div>
        </div>
        <div class="kit-color">
          <div class="kit-color__swatch" style="background:#7C4DFF;"></div>
          <div class="kit-color__info"><p class="kit-color__name">Purple</p><p class="kit-color__var">--color-purple · #7C4DFF</p></div>
        </div>
        <div class="kit-color">
          <div class="kit-color__swatch" style="background:#00BFAE;"></div>
          <div class="kit-color__info"><p class="kit-color__name">Teal</p><p class="kit-color__var">--color-teal · #00BFAE</p></div>
        </div>
        <div class="kit-color">
          <div class="kit-color__swatch" style="background:#FF2D55;"></div>
          <div class="kit-color__info"><p class="kit-color__name">Pink</p><p class="kit-color__var">--color-pink · #FF2D55</p></div>
        </div>
        <div class="kit-color">
          <div class="kit-color__swatch" style="background:#6B6B6B;"></div>
          <div class="kit-color__info"><p class="kit-color__name">Muted</p><p class="kit-color__var">--color-muted · #6B6B6B</p></div>
        </div>
        <div class="kit-color">
          <div class="kit-color__swatch" style="background:#1A73E8;"></div>
          <div class="kit-color__info"><p class="kit-color__name">Blue</p><p class="kit-color__var">--color-blue · #1A73E8</p></div>
        </div>
      </div>

      <div class="kit-separator"></div>

      <p class="kit-item__label" style="margin-bottom: var(--space-5);" data-en="Dark mode palette">Paleta dark mode</p>
      <div class="kit-color-grid">
        <div class="kit-color">
          <div class="kit-color__swatch" style="background:#1B1B1D;"></div>
          <div class="kit-color__info"><p class="kit-color__name">BG Dark</p><p class="kit-color__var">--color-bg-dk · #1B1B1D</p></div>
        </div>
        <div class="kit-color">
          <div class="kit-color__swatch" style="background:#E5D2AF;"></div>
          <div class="kit-color__info"><p class="kit-color__name">Ink Dark</p><p class="kit-color__var">--color-ink-dk · #E5D2AF</p></div>
        </div>
        <div class="kit-color">
          <div class="kit-color__swatch" style="background:#7B4600;"></div>
          <div class="kit-color__info"><p class="kit-color__name">Yellow Dark</p><p class="kit-color__var">--color-yellow-dk · #7B4600</p></div>
        </div>
        <div class="kit-color">
          <div class="kit-color__swatch" style="background:#008579;"></div>
          <div class="kit-color__info"><p class="kit-color__name">Teal Dark</p><p class="kit-color__var">--color-teal-dk · #008579</p></div>
        </div>
        <div class="kit-color">
          <div class="kit-color__swatch" style="background:#E71C42;"></div>
          <div class="kit-color__info"><p class="kit-color__name">Pink Dark</p><p class="kit-color__var">--color-pink-dk · #E71C42</p></div>
        </div>
      </div>
    </div>
  </section>

  <!-- 02 TIPOGRAFIA -->
  <section class="kit-section" id="tipografia">
    <div class="container">
      <div class="kit-section__header">
        <p class="kit-section__num">02</p>
        <h2 class="kit-section__title" data-en="Typography">Tipografia</h2>
      </div>

      <p class="kit-item__label" style="margin-bottom: var(--space-3);" data-en="Fonts">Fontes</p>
      <div class="kit-canvas" style="margin-bottom: var(--space-10);">
        <div class="kit-item">
          <span class="kit-item__label">Display · Syne</span>
          <p style="font-family: var(--font-display); font-size: var(--text-2xl); font-weight: 800; text-transform: uppercase; letter-spacing: -0.03em;">Syne — Bold Display</p>
          <span class="kit-item__code">--font-display</span>
        </div>
        <div class="kit-item">
          <span class="kit-item__label">Body · Inter</span>
          <p style="font-family: var(--font-body); font-size: var(--text-base);" data-en="Inter — Running text, descriptions, paragraphs and general portfolio content.">Inter — Texto corrido, descrições, parágrafos e conteúdo geral do portfólio.</p>
          <span class="kit-item__code">--font-body</span>
        </div>
        <div class="kit-item">
          <span class="kit-item__label">Mono · Space Mono</span>
          <p style="font-family: var(--font-mono); font-size: var(--text-sm); font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em;" data-en="SPACE MONO — LABELS, TAGS &amp; METADATA">SPACE MONO — LABELS, TAGS &amp; METADADOS</p>
          <span class="kit-item__code">--font-mono</span>
        </div>
      </div>

      <p class="kit-item__label" style="margin-bottom: var(--space-4);" data-en="Scale (Syne · fluid)">Escala (Syne · fluid)</p>
      <div style="border: var(--border);">
        <div class="kit-type-row">
          <span class="kit-type-row__meta">--text-hero<br>clamp(2–8rem)</span>
          <span style="font-family:var(--font-display); font-size:var(--text-hero); font-weight:800; text-transform:uppercase; letter-spacing:-0.04em; line-height:1;">Aa</span>
        </div>
        <div class="kit-type-row">
          <span class="kit-type-row__meta">--text-4xl<br>clamp(2–5.5rem)</span>
          <span style="font-family:var(--font-display); font-size:var(--text-4xl); font-weight:800; text-transform:uppercase; letter-spacing:-0.04em; line-height:1;" data-en="Projects.">Projetos.</span>
        </div>
        <div class="kit-type-row">
          <span class="kit-type-row__meta">--text-3xl<br>clamp(1.375–3.5rem)</span>
          <span style="font-family:var(--font-display); font-size:var(--text-3xl); font-weight:800; text-transform:uppercase; letter-spacing:-0.03em; line-height:1.05;" data-en="About me.">Sobre mim.</span>
        </div>
        <div class="kit-type-row">
          <span class="kit-type-row__meta">--text-2xl<br>clamp(1.75–2.5rem)</span>
          <span style="font-family:var(--font-display); font-size:var(--text-2xl); font-weight:800; text-transform:uppercase; letter-spacing:-0.03em;">MobiStudio</span>
        </div>
        <div class="kit-type-row">
          <span class="kit-type-row__meta">--text-xl<br>clamp(1.375–1.75rem)</span>
          <span style="font-family:var(--font-display); font-size:var(--text-xl); font-weight:800; text-transform:uppercase; letter-spacing:-0.02em;" data-en="Design + Code">Design + Código</span>
        </div>
        <div class="kit-type-row">
          <span class="kit-type-row__meta">--text-lg<br>clamp(1.125–1.375rem)</span>
          <span style="font-family:var(--font-body); font-size:var(--text-lg); line-height:1.5;" data-en="Bio text and featured descriptions">Texto de bio e descrições em destaque</span>
        </div>
        <div class="kit-type-row">
          <span class="kit-type-row__meta">--text-base<br>clamp(1–1.125rem)</span>
          <span style="font-family:var(--font-body); font-size:var(--text-base); line-height:1.6;" data-en="Standard paragraph, running portfolio content.">Parágrafo padrão, conteúdo corrido do portfólio.</span>
        </div>
        <div class="kit-type-row">
          <span class="kit-type-row__meta">--text-sm<br>clamp(0.875–1rem)</span>
          <span style="font-family:var(--font-body); font-size:var(--text-sm); line-height:1.65;" data-en="Card descriptions and project captions.">Descrições de cards e legendas de projeto.</span>
        </div>
        <div class="kit-type-row">
          <span class="kit-type-row__meta">--text-xs<br>clamp(0.75–0.875rem)</span>
          <span style="font-family:var(--font-mono); font-size:var(--text-xs); font-weight:700; text-transform:uppercase; letter-spacing:0.08em;" data-en="TAGS · LABELS · METADATA">TAGS · LABELS · METADADOS</span>
        </div>
      </div>

      <div class="kit-separator"></div>

      <p class="kit-item__label" style="margin-bottom: var(--space-5);" data-en="Text utilities">Utilitários de texto</p>
      <div class="kit-canvas">
        <div class="kit-item">
          <span class="kit-item__label">.highlight</span>
          <p style="font-family:var(--font-display); font-size:var(--text-xl); font-weight:800; text-transform:uppercase;" data-en="Let&apos;s create something <span class='highlight'>together?</span>">Vamos criar algo <span class="highlight">juntos?</span></p>
        </div>
        <div class="kit-item">
          <span class="kit-item__label">.highlight-yellow</span>
          <p style="font-family:var(--font-display); font-size:var(--text-xl); font-weight:800; text-transform:uppercase;">Adobe <span class="highlight-yellow">Certified</span></p>
        </div>
      </div>
    </div>
  </section>

  <!-- 03 SOMBRAS & BORDAS -->
  <section class="kit-section" id="sombras">
    <div class="container">
      <div class="kit-section__header">
        <p class="kit-section__num">03</p>
        <h2 class="kit-section__title" data-en="Shadows &amp; Borders">Sombras &amp; Bordas</h2>
      </div>

      <div class="kit-canvas" style="margin-bottom: var(--space-10);">
        <div class="kit-item">
          <span class="kit-item__label">--shadow-sm · 3px</span>
          <div class="kit-shadow-demo" style="box-shadow: var(--shadow-sm); min-width:140px;">Shadow SM</div>
        </div>
        <div class="kit-item">
          <span class="kit-item__label">--shadow-md · 5px</span>
          <div class="kit-shadow-demo" style="box-shadow: var(--shadow-md); min-width:140px;">Shadow MD</div>
        </div>
        <div class="kit-item">
          <span class="kit-item__label">--shadow-lg · 8px</span>
          <div class="kit-shadow-demo" style="box-shadow: var(--shadow-lg); min-width:140px;">Shadow LG</div>
        </div>
        <div class="kit-item">
          <span class="kit-item__label">--shadow-xl · 12px</span>
          <div class="kit-shadow-demo" style="box-shadow: var(--shadow-xl); min-width:140px;">Shadow XL</div>
        </div>
      </div>

      <div class="kit-canvas">
        <div class="kit-item">
          <span class="kit-item__label">--border (2px)</span>
          <div style="border: var(--border); padding: var(--space-5) var(--space-8); font-family:var(--font-mono); font-size:var(--text-xs); font-weight:700; text-transform:uppercase;" data-en="Standard border">Border padrão</div>
        </div>
        <div class="kit-item">
          <span class="kit-item__label">--border-thick (3px)</span>
          <div style="border: var(--border-thick); padding: var(--space-5) var(--space-8); font-family:var(--font-mono); font-size:var(--text-xs); font-weight:700; text-transform:uppercase;" data-en="Thick border">Border espessa</div>
        </div>
      </div>
    </div>
  </section>

  <!-- 04 TAGS -->
  <section class="kit-section" id="tags">
    <div class="container">
      <div class="kit-section__header">
        <p class="kit-section__num">04</p>
        <h2 class="kit-section__title">Tags</h2>
      </div>

      <div class="kit-canvas">
        <div class="kit-item">
          <span class="kit-item__label">.tag (default)</span>
          <span class="tag">Adobe Certified ✦</span>
        </div>
        <div class="kit-item">
          <span class="kit-item__label">.tag--dark</span>
          <span class="tag tag--dark" data-en="Personal Project">Projeto Autoral</span>
        </div>
        <div class="kit-item">
          <span class="kit-item__label">.tag--red</span>
          <span class="tag tag--red" data-en="Urgent">Urgente</span>
        </div>
        <div class="kit-item">
          <span class="kit-item__label">.tag--green</span>
          <span class="tag tag--green" data-en="Available">Disponível</span>
        </div>
        <div class="kit-item">
          <span class="kit-item__label">.tag--blue</span>
          <span class="tag tag--blue">Dev Web</span>
        </div>
        <div class="kit-item">
          <span class="kit-item__label">.tag--ghost</span>
          <span class="tag tag--ghost">Ghost</span>
        </div>
      </div>

      <div class="kit-separator"></div>

      <div class="kit-canvas">
        <div class="kit-item">
          <span class="kit-item__label">.tech-tag</span>
          <div style="display:flex; gap: var(--space-2); flex-wrap:wrap;">
            <span class="tech-tag">JavaScript</span>
            <span class="tech-tag">Canvas API</span>
            <span class="tech-tag">Figma</span>
            <span class="tech-tag">Netlify</span>
            <span class="tech-tag">Blender</span>
          </div>
        </div>
      </div>

      <div class="kit-separator"></div>

      <div class="kit-canvas">
        <div class="kit-item">
          <span class="kit-item__label">.available-badge</span>
          <div style="display:flex; gap: var(--space-3); flex-wrap:wrap;">
            <span class="available-badge" data-en="On-site">Presencial</span>
            <span class="available-badge" data-en="Hybrid">Híbrido</span>
            <span class="available-badge">Freelance</span>
          </div>
        </div>
      </div>

      <div class="kit-separator"></div>

      <div class="kit-canvas">
        <div class="kit-item">
