    caption: 'Taverna · Referência 3D',
    captionEn: 'Tavern · 3D Reference',
    tool: 'Blender',
    phase: 'reference' as const,
  },
  {
    src: '/projetos/cavaleiro_de_latao/processo_02.webp',
    alt: 'Ficino e sprites finais em pixel art no Aseprite',
