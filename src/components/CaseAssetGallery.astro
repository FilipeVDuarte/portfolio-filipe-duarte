---
interface GalleryItem {
  src: string;
  alt: string;
  caption: string;
  captionEn: string;
  tool: string;
  phase: 'reference' | 'final';
}

interface Props {
  items: GalleryItem[];
  phaseALabel?: string;
  phaseALabelEn?: string;
  phaseBLabel?: string;
  phaseBLabelEn?: string;
  phaseCLabel?: string;
  phaseCLabelEn?: string;
  phaseDLabel?: string;
  phaseDLabelEn?: string;
  phaseELabel?: string;
  phaseELabelEn?: string;
  phaseFLabel?: string;
  phaseFLabelEn?: string;
  phaseGLabel?: string;
  phaseGLabelEn?: string;
  phaseHLabel?: string;
  phaseHLabelEn?: string;
  phaseILabel?: string;
  phaseILabelEn?: string;
  phaseJLabel?: string;
  phaseJLabelEn?: string;
}

const {
  items,
  phaseALabel = 'Modelagem 3D',
  phaseALabelEn = '3D Modeling',
  phaseBLabel = 'Sprites',
  phaseBLabelEn = 'Sprites',
  phaseCLabel = 'Mapa',
  phaseCLabelEn = 'Map',
  phaseDLabel = 'Inimigos',
  phaseDLabelEn = 'Enemies',
  phaseELabel = 'Pausa',
  phaseELabelEn = 'Pause',
} = Astro.props;

const refItems  = items.filter(i => i.phase === 'reference');
const finalItems = items.filter(i => i.phase === 'final');
---

<div class="asset-gallery" data-reveal>
  {refItems.length > 0 && (
    <div class="asset-gallery__phase">
      <div class="asset-gallery__phase-header">
        <span class="asset-gallery__phase-badge" data-en={phaseALabelEn}>{phaseALabel}</span>
        <span class="asset-gallery__phase-arrow" aria-hidden="true">→</span>
        <span class="asset-gallery__phase-badge" data-en={phaseBLabelEn}>{phaseBLabel}</span>
        <span class="asset-gallery__phase-arrow" aria-hidden="true">→</span>
        <span class="asset-gallery__phase-badge" data-en={phaseCLabelEn}>{phaseCLabel}</span>
        <span class="asset-gallery__phase-arrow" aria-hidden="true">→</span>
        <span class="asset-gallery__phase-badge" data-en={phaseDLabelEn}>{phaseDLabel}</span>
        <span class="asset-gallery__phase-arrow" aria-hidden="true">→</span>
        <span class="asset-gallery__phase-badge" data-en={phaseELabelEn}>{phaseELabel}</span>
      </div>
      <div class="asset-gallery__grid">
        {refItems.map((item) => (
          <figure class="asset-gallery__item">
            <div class="asset-gallery__frame asset-gallery__frame--3d">
              <img
                class="asset-gallery__img"
                src={item.src}
                alt={item.alt}
                loading="lazy"
                decoding="async"
              />
              <span class="asset-gallery__tool-badge">{item.tool}</span>
            </div>
            <figcaption class="asset-gallery__caption" data-en={item.captionEn}>{item.caption}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  )}

  {refItems.length > 0 && finalItems.length > 0 && (
    <div class="asset-gallery__evolution" aria-hidden="true">
      <span class="asset-gallery__evolution-label" data-en="visual evolution ↓">Mudanças de planos ↓</span>
    </div>
  )}

  {finalItems.length > 0 && (
    <div class="asset-gallery__phase">
      <div class="asset-gallery__phase-header">
        <span class="asset-gallery__phase-badge asset-gallery__phase-badge--final" data-en={phaseFLabelEn}>{phaseFLabel}</span>
        <span class="asset-gallery__phase-arrow" aria-hidden="true">→</span>
        <span class="asset-gallery__phase-badge asset-gallery__phase-badge--final" data-en={phaseGLabelEn}>{phaseGLabel}</span>
        <span class="asset-gallery__phase-arrow" aria-hidden="true">→</span>
        <span class="asset-gallery__phase-badge asset-gallery__phase-badge--final" data-en={phaseHLabelEn}>{phaseHLabel}</span>
        <span class="asset-gallery__phase-arrow" aria-hidden="true">→</span>
        <span class="asset-gallery__phase-badge asset-gallery__phase-badge--final" data-en={phaseILabelEn}>{phaseILabel}</span>
        <span class="asset-gallery__phase-arrow" aria-hidden="true">→</span>
        <span class="asset-gallery__phase-badge asset-gallery__phase-badge--final" data-en={phaseJLabelEn}>{phaseJLabel}</span>
      </div>
      <div class="asset-gallery__grid">
        {finalItems.map((item) => (
          <figure class="asset-gallery__item">
            <div class="asset-gallery__frame asset-gallery__frame--pixel">
              <img
                class="asset-gallery__img"
                src={item.src}
                alt={item.alt}
                loading="lazy"
                decoding="async"
              />
              <span class="asset-gallery__tool-badge asset-gallery__tool-badge--pixel">{item.tool}</span>
            </div>
            <figcaption class="asset-gallery__caption" data-en={item.captionEn}>{item.caption}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  )}
</div>

<style>
.asset-gallery {
  margin-bottom: var(--space-8);
}
.asset-gallery__phase {
  margin-bottom: var(--space-6);
}
.asset-gallery__phase-header {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  margin-bottom: var(--space-4);
}
.asset-gallery__phase-badge {
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--color-muted);
  background: var(--color-surface);
  border: var(--border-thick);
  padding: var(--space-1) var(--space-3);
}
.asset-gallery__phase-badge--final {
  background: var(--color-ink);
  color: var(--color-bg);
  border-color: var(--color-ink);
}
.asset-gallery__phase-arrow {
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  color: var(--color-muted);
}
.asset-gallery__grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  gap: var(--space-4);
}
.asset-gallery__item {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
  margin: 0;
}
.asset-gallery__frame {
  position: relative;
  aspect-ratio: 4 / 3;
  border: var(--border-thick);
  overflow: hidden;
  background: #0a0a0a;
}
.asset-gallery__frame--pixel {
  background: #1a1a2e;
}
.asset-gallery__img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform var(--transition-base);
}
.asset-gallery__frame--pixel .asset-gallery__img {
  image-rendering: pixelated;
  image-rendering: crisp-edges;
  object-fit: contain;
}
.asset-gallery__frame:hover .asset-gallery__img {
  transform: scale(1.04);
}
.asset-gallery__tool-badge {
  position: absolute;
  bottom: var(--space-2);
  right: var(--space-2);
  font-family: var(--font-mono);
  font-size: 0.6rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  background: var(--color-ink);
  color: var(--color-bg);
  padding: 2px var(--space-2);
}
.asset-gallery__tool-badge--pixel {
  background: var(--color-purple);
  color: #fff;
}
.asset-gallery__caption {
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: var(--color-muted);
}
.asset-gallery__evolution {
  display: flex;
  justify-content: center;
  padding-block: var(--space-3);
  border-block: var(--border);
  margin-bottom: var(--space-6);
}
.asset-gallery__evolution-label {
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--color-muted);
}
@media (max-width: 599px) {
  .asset-gallery__grid {
    grid-template-columns: repeat(2, 1fr);
  }
}
</style>
