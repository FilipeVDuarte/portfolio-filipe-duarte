const repoStats = [
  { value: '75',          label: 'Commits',         labelEn: 'Commits',          sublabel: 'Jun–Jul 2024',         sublabelEn: 'Jun–Jul 2024',         accent: true,  mono: false },
  { value: '27',          label: 'Scripts GD',      labelEn: 'GD Scripts',       sublabel: 'arquivos .gd',         sublabelEn: '.gd files',             accent: false, mono: false },
  { value: 'Godot 4.2',   label: 'Engine',          labelEn: 'Engine',           sublabel: 'Forward Plus',         sublabelEn: 'Forward Plus',          accent: false, mono: true  },
  { value: 'HTML5',       label: 'Exportação',      labelEn: 'Export',           sublabel: 'sem instalação',       sublabelEn: 'no install',            accent: false, mono: true  },
  { value: '2',           label: 'Fases',           labelEn: 'Levels',           sublabel: 'Level 1 + Boss',       sublabelEn: 'Level 1 + Boss',        accent: false, mono: false },
