</style>

<script>
  (function () {
    // ── Review data from build-time JSON ──────────────────────────────────
    type ReviewPayload = {
      title: string; year: string; month: string; rating: number;
      reviewHtml: string; poster: string; link: string;
      rewatch: boolean; hasSpoiler: boolean; director?: string;
    };
    let reviewData: Record<string, ReviewPayload> = {};
    try {
      const el = document.getElementById('cdReviewData');
      if (el) reviewData = JSON.parse(el.textContent ?? '{}');
    } catch (_) {}

    // ── Stars helper ───────────────────────────────────────────────────────
    function starsHTML(r: number): string {
      const full = Math.floor(r);
      const half = (r - full) >= 0.5;
      const off  = 5 - full - (half ? 1 : 0);
      let s = '★'.repeat(full);
      if (half) s += '<span class="cd-stars-half">½</span>';
      if (off > 0) s += `<span class="cd-stars-off">${'★'.repeat(off)}</span>`;
      return `<span class="cd-stars">${s}</span>`;
    }
    function fmtRating(r: number): string {
      return r.toFixed(1).replace('.', ',').replace(',0', '');
    }

    // ── Modal elements ─────────────────────────────────────────────────────
    const back        = document.getElementById('cdModalBack')!;
    const modal       = document.getElementById('cdModal')!;
    const mdMonth     = document.getElementById('cdMdMonth')!;
    const mdTitle     = document.getElementById('cdMdTitle')!;
    const mdYear      = document.getElementById('cdMdYear')!;
    const mdDirector  = document.getElementById('cdMdDirector')!;
    const mdStars     = document.getElementById('cdMdStars')!;
    const mdBadges    = document.getElementById('cdMdBadges')!;
    const mdSpoiler   = document.getElementById('cdMdSpoiler')!;
    const mdReview    = document.getElementById('cdMdReview')!;
    const mdPoster    = document.getElementById('cdMdPoster') as HTMLImageElement;
    const mdLink      = document.getElementById('cdMdLink') as HTMLAnchorElement;

    function openModal(guid: string) {
      const d = reviewData[guid];
      if (!d) return;

      mdMonth.textContent    = d.month;
      mdTitle.textContent    = d.title;
      mdYear.textContent     = d.year;
      mdDirector.textContent = d.director ? `Dir. ${d.director}` : '';
      mdStars.innerHTML      = starsHTML(d.rating);
      mdPoster.src           = d.poster;
      mdPoster.alt           = `Pôster de ${d.title}`;
      mdLink.href            = d.link;
      mdSpoiler.style.display = d.hasSpoiler ? 'block' : 'none';
      mdReview.innerHTML     = d.reviewHtml || '<p style="color:var(--color-muted);font-style:italic">Sem crítica escrita.</p>';

      // badges
      const badges: string[] = [];
      if (d.rewatch) badges.push('<span class="cd-chip cd-chip--on">Rewatch</span>');
      badges.push(`<span class="cd-chip">${d.year}</span>`);
      mdBadges.innerHTML = badges.join('');

      back.classList.add('is-open');
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      document.getElementById('cdModalClose')?.focus();
    }

    function closeModal() {
      back.classList.remove('is-open');
      modal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    // Delegate clicks: featured cards + grid cards
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const featured = target.closest<HTMLElement>('.cd-featured');
      if (featured?.dataset.guid) { openModal(featured.dataset.guid); return; }
      const gridCard = target.closest<HTMLElement>('.cd-gcard');
      if (gridCard?.dataset.guid) openModal(gridCard.dataset.guid);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        const target = e.target as HTMLElement;
        const featured = target.closest<HTMLElement>('.cd-featured');
        const card     = target.closest<HTMLElement>('.cd-gcard');
        const guid = featured?.dataset.guid ?? card?.dataset.guid;
        if (guid) { e.preventDefault(); openModal(guid); }
      }
      if (e.key === 'Escape') closeModal();
    });

    back.addEventListener('click', (e) => { if (e.target === back) closeModal(); });
    document.getElementById('cdModalClose')?.addEventListener('click', closeModal);

  })();
</script>

<script>
  (function () {
    const stack = document.getElementById('cdFeaturedStack') as HTMLElement | null;
    if (!stack) return;
    const cards = Array.from(stack.querySelectorAll<HTMLElement>('.cd-featured'));
    if (cards.length <= 1) return;

    const btnPrev = document.getElementById('cdCarouselPrev') as HTMLButtonElement | null;
    const btnNext = document.getElementById('cdCarouselNext') as HTMLButtonElement | null;

    let index = 0;
    const total = cards.length;

    function step(): number {
      const card = cards[0]!;
      const gap  = parseFloat(getComputedStyle(stack!).gap) || 0;
      return card.getBoundingClientRect().width + gap;
    }

    function updateButtons() {
      if (btnPrev) btnPrev.disabled = index === 0;
      if (btnNext) btnNext.disabled = index === total - 1;
    }

    function goTo(i: number) {
      index = Math.max(0, Math.min(i, total - 1));
      stack!.style.transform = `translateX(${-index * step()}px)`;
      updateButtons();
    }

    stack.style.transition = 'transform 0.4s ease';
    goTo(0);

    btnPrev?.addEventListener('click', () => goTo(index - 1));
    btnNext?.addEventListener('click', () => goTo(index + 1));
  })();
</script>
