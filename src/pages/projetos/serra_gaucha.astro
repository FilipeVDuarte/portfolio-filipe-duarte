      <script>
        (function () {
          const picker = document.querySelector('.brand-picker');
          if (!picker) return;
          const card = document.getElementById('picker-card');
          const word = document.getElementById('picker-word');
          const tagline = document.getElementById('picker-tagline');
          const colorBtns = picker.querySelectorAll('.brand-picker__swatch');
          const fontBtns = picker.querySelectorAll('.brand-picker__font');

          colorBtns.forEach((btn) => {
            btn.addEventListener('click', () => {
              colorBtns.forEach((b) => b.classList.remove('is-active'));
              btn.classList.add('is-active');
              card.style.setProperty('--picker-color', btn.dataset.color);
            });
          });

          fontBtns.forEach((btn) => {
            btn.addEventListener('click', () => {
              fontBtns.forEach((b) => b.classList.remove('is-active'));
              btn.classList.add('is-active');
              word.style.fontFamily = btn.dataset.font;
              tagline.style.fontFamily = btn.dataset.font;
            });
          });
        })();
      </script>

