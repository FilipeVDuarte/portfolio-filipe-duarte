      <div class="case-section__header">
        <p class="section-label" id="docs-title" data-en="Documents — read online">Documentos — leia online</p>
        <span class="case-section__note" data-en="scroll inside to read · download available">role dentro para ler · download disponível</span>
      </div>

      <div class="doc-reader" data-reveal>
        <div class="doc-reader__tabs" role="tablist" aria-label="Selecionar documento">
          <button type="button" class="doc-reader__tab is-active" data-doc="miv" role="tab" aria-selected="true" data-en="Brand Manual">Manual de Identidade</button>
          <button type="button" class="doc-reader__tab" data-doc="defesa" role="tab" aria-selected="false" data-en="Conceptual Defense">Defesa Conceitual</button>
        </div>

        <div class="doc-reader__frame">
          <iframe
            id="doc-frame-miv"
            class="doc-reader__iframe is-active"
            title="Manual de Identidade Visual — Serra Gaúcha"
            data-src="/projetos/serra_gaucha/pdf/MIV.pdf#toolbar=1&view=FitH"
            loading="lazy"></iframe>
          <iframe
            id="doc-frame-defesa"
            class="doc-reader__iframe"
            title="Defesa Conceitual — Serra Gaúcha"
            data-src="/projetos/serra_gaucha/pdf/Defesa-Conceitual.pdf#toolbar=1&view=FitH"
            loading="lazy"></iframe>
        </div>

        <div class="doc-reader__actions">
          <a id="doc-download" class="btn btn--primary" href="/projetos/serra_gaucha/pdf/MIV.pdf" download data-en="Download PDF ↓">Baixar PDF ↓</a>
          <span class="doc-reader__hint" data-en="If the viewer doesn't load on your device, use the download link above.">Se o leitor não carregar no seu dispositivo, use o link de download acima.</span>
        </div>
      </div>

      <script>
        (function () {
          const tabs = document.querySelectorAll('.doc-reader__tab');
          const frames = document.querySelectorAll('.doc-reader__iframe');
          const downloadLink = document.getElementById('doc-download');
          const docFiles = {
            miv: { file: '/projetos/serra_gaucha/pdf/MIV.pdf', label: { pt: 'Baixar PDF ↓', en: 'Download PDF ↓' } },
            defesa: { file: '/projetos/serra_gaucha/pdf/Defesa-Conceitual.pdf', label: { pt: 'Baixar PDF ↓', en: 'Download PDF ↓' } },
          };

          function loadFrame(doc) {
            const frame = document.getElementById('doc-frame-' + doc);
            if (frame && !frame.getAttribute('src') && frame.dataset.src) {
              frame.setAttribute('src', frame.dataset.src);
            }
          }

          // Only the first (active) document loads on page load — the other two
          // load on demand so the browser isn't rendering three PDFs at once.
          loadFrame('miv');

          tabs.forEach((tab) => {
            tab.addEventListener('click', () => {
              const doc = tab.getAttribute('data-doc');
              tabs.forEach((t) => { t.classList.remove('is-active'); t.setAttribute('aria-selected', 'false'); });
              frames.forEach((f) => f.classList.remove('is-active'));
              tab.classList.add('is-active');
              tab.setAttribute('aria-selected', 'true');
              loadFrame(doc);
              document.getElementById('doc-frame-' + doc)?.classList.add('is-active');
              if (downloadLink && docFiles[doc]) downloadLink.setAttribute('href', docFiles[doc].file);
            });
          });
        })();
      </script>

      <style>
        .doc-reader { border: var(--border-thick); background: var(--color-bg); box-shadow: var(--shadow-xl); }
        .doc-reader__tabs { display: flex; flex-wrap: wrap; border-bottom: var(--border-thick); }
        .doc-reader__tab {
          flex: 1 1 auto; min-width: 160px; padding: var(--space-4) var(--space-3);
          font-family: var(--font-mono); font-size: var(--text-xs); font-weight: 700;
          text-transform: uppercase; letter-spacing: 0.06em; color: var(--color-muted);
          background: var(--color-surface); border: none; border-right: var(--border-thick);
          cursor: pointer;
        }
        .doc-reader__tab:last-child { border-right: none; }
        .doc-reader__tab.is-active { background: var(--color-yellow); color: var(--color-ink); }
        .doc-reader__frame { position: relative; width: 100%; height: min(85vh, 900px); background: #3c3c3c; }
        .doc-reader__iframe {
          position: absolute; inset: 0; width: 100%; height: 100%; border: none;
          display: none;
        }
        .doc-reader__iframe.is-active { display: block; }
        .doc-reader__actions {
          display: flex; align-items: center; gap: var(--space-4); flex-wrap: wrap;
          padding: var(--space-4) var(--space-5); border-top: var(--border-thick);
        }
        .doc-reader__hint { font-size: var(--text-xs); color: var(--color-muted); }
      </style>
    </div>
  </section>

