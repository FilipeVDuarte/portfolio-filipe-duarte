---
import Base from '../layouts/Base.astro';
---

<Base
  title="Projetos — Filipe Duarte"
  description="Projetos de Filipe Duarte — Design Gráfico, Dev Web, 3D, Audiovisual e Fotografia. Portfólio completo com mais de 4 anos de trabalho."
  canonical="/projetos.html"
  ogTitle="Projetos — Filipe Duarte"
  ogDescription="Acervo completo de projetos: Design, Dev Web, 3D, Audiovisual e Fotografia."
  schemaLD={[{
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": "Projetos — Filipe Duarte",
    "description": "Portfólio completo de Filipe Duarte",
    "url": "https://filipeduarte.netlify.app/projetos.html",
    "author": { "@type": "Person", "name": "Filipe Duarte" }
  }]}
  currentPage="projetos"
  withContactFooter={true}
>

  <!-- PAGE HEADER -->
  <section class="page-header" style="padding-top: calc(60px + var(--space-12));">
    <div class="container">
      <p class="page-header__eyebrow" data-en="Full Portfolio">Acervo completo</p>
      <div class="page-header__grid">
        <h1 class="page-header__title" data-en="Projects.">Projetos.</h1>
        <p class="page-header__desc" data-en="4+ years of work — design, code, 3D and audiovisual. Filter by what interests you.">
          O acervo cobre 4+ anos de trabalho — design, código, 3D e audiovisual.
          Filtre pelo que interessa.
        </p>
      </div>
    </div>
  </section>

  <!-- PROJETOS GRID -->
  <section class="projetos-page" aria-labelledby="projetos-title">
    <div class="container">
      <h2 class="sr-only" id="projetos-title" data-en="Project list">Lista de projetos</h2>

      <!-- FILTER BAR -->
      <div class="filter-bar" role="group" aria-label="Filtrar por categoria">
        <button class="filter-btn active" data-filter="todos" aria-pressed="true"
          data-en="All">Todos</button>
        <button class="filter-btn" data-filter="dev-web" aria-pressed="false"
          data-en="Web Dev">Web Design</button>
        <button class="filter-btn" data-filter="design-grafico" aria-pressed="false"
          data-en="Graphic Design">Design Gráfico</button>
        <button class="filter-btn" data-filter="3d" aria-pressed="false">3D</button>
        <button class="filter-btn" data-filter="audiovisual" aria-pressed="false"
          data-en="Audiovisual">Audiovisual</button>
        <button class="filter-btn" data-filter="fotografia" aria-pressed="false"
          data-en="Photography">Fotografia</button>
        <span class="filter-bar__count" aria-live="polite" aria-atomic="true" id="filter-count" data-en="13 projects">13 projetos</span>
      </div>

      <!-- GRID -->
      <div class="projetos-grid" id="projetos-grid">

        <!-- Design Kit — Mai 2026 -->
        <article class="proj-card" data-cat="dev-web" data-reveal aria-labelledby="proj-designkit">
          <a href="kit.html" class="proj-card__thumb" aria-label="Ver Design Kit">
            <div style="position:absolute;inset:0;background:var(--color-ink);display:flex;flex-direction:column;align-items:flex-start;justify-content:space-between;padding:var(--space-5);">
              <div style="display:flex;gap:6px;">
                <div style="width:20px;height:20px;background:#FFC300;border:2px solid rgba(255,255,255,.2);"></div>
                <div style="width:20px;height:20px;background:#7C4DFF;border:2px solid rgba(255,255,255,.2);"></div>
                <div style="width:20px;height:20px;background:#00BFAE;border:2px solid rgba(255,255,255,.2);"></div>
                <div style="width:20px;height:20px;background:#FF2D55;border:2px solid rgba(255,255,255,.2);"></div>
                <div style="width:20px;height:20px;background:#F2F0EF;border:2px solid rgba(255,255,255,.2);"></div>
              </div>
              <p style="font-family:var(--font-display);font-size:var(--text-2xl);font-weight:800;text-transform:uppercase;letter-spacing:-0.04em;color:var(--color-bg);line-height:1;" data-en="Design<br>Kit">Design<br>Kit</p>
            </div>
          </a>
          <div class="proj-card__body">
            <div class="proj-card__header">
              <h3 class="proj-card__title" id="proj-designkit" data-en="Design Kit">Design Kit</h3>
              <span class="tag" data-en="Dev<br>Web">Dev<br>Web</span>
            </div>
            <p class="proj-card__desc" data-en="Design system built from scratch for this portfolio — color tokens, typography, shadows and every reusable component. Pure CSS, no frameworks.">
              Sistema de design construído do zero para esse portfólio — tokens de cor, tipografia, sombras e todos os componentes reutilizáveis. CSS puro, sem frameworks.
            </p>
            <div class="projeto__tech">
              <span class="tech-tag">CSS</span>
              <span class="tech-tag" data-en="Design System">Design System</span>
              <span class="tech-tag" data-en="Neo-Brutalism">Neo-Brutalismo</span>
            </div>
            <div class="proj-card__actions">
              <a href="kit.html" class="btn btn--primary" data-en="View Design Kit →">Ver Design Kit →</a>
            </div>
          </div>
        </article>

        <!-- Animações Cavalry — Abr 2026 -->
        <article class="proj-card" data-cat="audiovisual" data-reveal data-reveal-delay="1" aria-labelledby="proj-cavalry">
          <a href="projetos/animas_cavalry.html" class="proj-card__thumb" aria-label="Ver Animações Cavalry">
            <div style="position:absolute;inset:0;background:#0a0a0a;display:flex;flex-direction:column;align-items:flex-start;justify-content:space-between;padding:var(--space-5);">
              <span style="font-family:var(--font-mono);font-size:var(--text-xs);font-weight:700;text-transform:uppercase;letter-spacing:0.1em;color:rgba(255,255,255,.35);" data-en="Motion · Generative">Motion · Generativo</span>
              <p style="font-family:var(--font-display);font-size:var(--text-2xl);font-weight:800;text-transform:uppercase;letter-spacing:-0.04em;color:#fff;line-height:1.05;" data-en="Cavalry<br>Animations.">Animações<br>Cavalry.</p>
            </div>
            <video class="proj-card__hover" muted loop playsinline aria-hidden="true">
              <source src="projetos/animas_cavalry/01_Wavy Lines.webm" type="video/webm" />
            </video>
          </a>
          <div class="proj-card__body">
            <div class="proj-card__header">
              <h3 class="proj-card__title" id="proj-cavalry" data-en="Cavalry Animations">Animações Cavalry</h3>
              <span class="tag" data-en="Audio<br>visual">Audi<br>visu</span>
            </div>
            <p class="proj-card__desc" data-en="19 experiments in procedural motion design — noise, physics, shaders, morphology and generative effects created in Cavalry.">
              19 experimentos em motion design procedural — ruído, física, shaders, morfologia e efeitos generativos criados no Cavalry.
            </p>
            <div class="projeto__tech">
              <span class="tech-tag">Cavalry</span>
              <span class="tech-tag">Motion Design</span>
              <span class="tech-tag" data-en="Generative">Generativo</span>
            </div>
            <div class="proj-card__actions">
              <a href="projetos/animas_cavalry.html" class="btn btn--primary" data-en="View gallery ↗">Ver galeria ↗</a>
            </div>
          </div>
        </article>

        <!-- MobiStudio — Abr 2026 -->
        <article class="proj-card" data-cat="dev-web" data-reveal data-reveal-delay="2" aria-labelledby="proj-mobistudio">
          <a href="projetos/mobi_studio.html" class="proj-card__thumb" aria-label="Ver MobiStudio">
            <img src="projetos/mobi_studio/Banner_MobiStudio_21_9.webp"
                 alt="Banner MobiStudio" width="1260" height="540" loading="eager" class="proj-card__static" />
            <video class="proj-card__hover" muted loop playsinline aria-hidden="true">
              <source src="projetos/mobi_studio/demonstrativo.webm" type="video/webm" />
            </video>
          </a>
          <div class="proj-card__body">
            <div class="proj-card__header">
              <h3 class="proj-card__title" id="proj-mobistudio" data-en="MobiStudio">MobiStudio</h3>
              <span class="tag" data-en="Dev<br>Web">Dev<br>Web</span>
            </div>
            <p class="proj-card__desc" data-en="Interactive phone case customizer. Canvas API engine with zoom, rotation and drag.
              From problem to production deploy.">
              Customizador interativo de capinhas. Motor Canvas API com zoom, rotação e arraste.
              Do problema ao deploy em produção.
            </p>
            <div class="projeto__tech">
              <span class="tech-tag">JavaScript</span>
              <span class="tech-tag">Canvas API</span>
              <span class="tech-tag">Netlify</span>
            </div>
            <div class="proj-card__actions">
              <a href="projetos/mobi_studio.html" class="btn btn--primary" data-en="View project ↗">Ver projeto ↗</a>
            </div>
          </div>
        </article>

        <!-- Estampas MobiStudio — 2026 -->
        <article class="proj-card" data-cat="design-grafico" data-reveal aria-labelledby="proj-estampas">
          <a href="projetos/mobi_estampas.html" class="proj-card__thumb" aria-label="Ver Estampas MobiStudio">
            <img src="projetos/mobi_estampas/Banner_mobiestampas_21_9.webp"
                 alt="Estampas Autorais MobiStudio" width="1260" height="540" loading="lazy" class="proj-card__static" />
            <video class="proj-card__hover" muted loop playsinline aria-hidden="true">
              <source src="projetos/mobi_estampas/Processo_06.webm" type="video/webm" />
            </video>
          </a>
          <div class="proj-card__body">
            <div class="proj-card__header">
              <h3 class="proj-card__title" id="proj-estampas" data-en="MobiStudio Patterns">Estampas MobiStudio</h3>
              <span class="tag" data-en="Graph<br>Design">Desi<br>Graf</span>
            </div>
            <p class="proj-card__desc" data-en="70+ custom pattern designs for MobiStudio.
              Graphic production combined with the proprietary interactive tool.">
              70+ artes para estampas personalizadas dentro do MobiStudio.
              Produção gráfica unida à ferramenta interativa proprietária.
            </p>
            <div class="projeto__tech">
              <span class="tech-tag">Illustrator</span>
              <span class="tech-tag">Photoshop</span>
            </div>
            <div class="proj-card__actions">
              <a href="projetos/mobi_estampas.html" class="btn btn--primary" data-en="View project ↗">Ver projeto ↗</a>
            </div>
          </div>
        </article>

        <!-- 3D Mobifans — 2026 -->
        <article class="proj-card" data-cat="3d" data-reveal data-reveal-delay="1" aria-labelledby="proj-mobifans3d">
          <a href="projetos/mobi_3d.html" class="proj-card__thumb" aria-label="Ver 3D Mobifans">
            <img src="projetos/mobi_3d/Banner_mobi_3d_21_9.webp"
                 alt="3D Mobifans — modelagem, renders e animações" width="1260" height="540" loading="lazy" />
          </a>
          <div class="proj-card__body">
            <div class="proj-card__header">
              <h3 class="proj-card__title" id="proj-mobifans3d" data-en="3D Mobifans">3D Mobifans</h3>
              <span class="tag">3D</span>
            </div>
            <p class="proj-card__desc" data-en="From supplier to feed: technical modeling based on real measurements, product renders
              and animations published on Mobifans' Instagram — including the Animation Triad.">
              Do fornecedor ao feed: modelagem técnica a partir de medidas reais, renders de produto
              e animações publicadas no Instagram da Mobifans — incluindo a Tríade de Animações.
            </p>
            <div class="projeto__tech">
              <span class="tech-tag">Blender</span>
              <span class="tech-tag">After Effects</span>
              <span class="tech-tag">Motion</span>
            </div>
            <div class="proj-card__actions">
              <a href="projetos/mobi_3d.html" class="btn btn--primary" data-en="View project ↗">Ver projeto ↗</a>
            </div>
          </div>
        </article>

        <!-- Placas, Wallets e Crossbody — 2026 -->
        <article class="proj-card" data-cat="design-grafico" data-reveal data-reveal-delay="2" aria-labelledby="proj-wallets">
          <a href="projetos/mobi_placas.html" class="proj-card__thumb" aria-label="Ver Placas, Wallets e Crossbody">
            <img src="projetos/mobi_placas/Banner_PlacasQuiosque_21_9.webp"
                 alt="Placas, Wallets e Crossbody — Mobifans" width="1260" height="540" loading="lazy" />
          </a>
          <div class="proj-card__body">
            <div class="proj-card__header">
              <h3 class="proj-card__title" id="proj-wallets" data-en="Plaques, Wallets and Crossbody Bags">Placas, Wallets e Crossbody</h3>
              <span class="tag" data-en="Graph<br>Design">Desi<br>Graf</span>
            </div>
            <p class="proj-card__desc" data-en="Graphic campaign for new Mobifans products with digital and printed pieces
              in a consistent visual identity.">
              Campanha gráfica para novos produtos Mobifans com peças digitais e impressas
              de identidade visual consistente.
            </p>
            <div class="projeto__tech">
              <span class="tech-tag">Illustrator</span>
              <span class="tech-tag">Photoshop</span>
            </div>
            <div class="proj-card__actions">
              <a href="projetos/mobi_placas.html" class="btn btn--primary" data-en="View project ↗">Ver projeto ↗</a>
            </div>
          </div>
        </article>

        <!-- Alças Flat Customic — Dez 2025 -->
        <article class="proj-card" data-cat="design-grafico" data-reveal aria-labelledby="proj-alcas">
          <a href="projetos/mobi_alcas.html" class="proj-card__thumb" aria-label="Ver Projeto Alças">
            <img src="projetos/mobi_alcas/Banner_Alças_21_9.webp"
                 alt="Capa do Projeto Alças" width="1260" height="540" loading="lazy" />
          </a>
          <div class="proj-card__body">
            <div class="proj-card__header">
              <h3 class="proj-card__title" id="proj-alcas" data-en="Flat <br> Straps <br>Customic">Alças <br> Flat <br>Customic</h3>
              <span class="tag" data-en="PROD<br> MULT">PROD<br> MULT</span>
            </div>
            <p class="proj-card__desc" data-en="Planned to promote a new Customic product in Mobifans stores.
              <br>Aimed at developing content primarily for social media.">
              Planejado para promover um novo produto Customic nas lojas Mobifans.
              <br>Com o intuito de desenvolver conteúdos majoritariamente para as redes sociais.
            </p>
            <div class="projeto__tech">
              <span class="tech-tag" data-en="Photography">Fotografia</span>
              <span class="tech-tag" data-en="Visual Identity">Identidade Visual</span>
            </div>
            <div class="proj-card__actions">
              <a href="projetos/mobi_alcas.html" class="btn btn--primary" data-en="View project ↗">Ver projeto ↗</a>
            </div>
          </div>
        </article>

        <!-- Rap In Cena — 2025 -->
        <article class="proj-card" data-cat="design-grafico" data-reveal data-reveal-delay="1" aria-labelledby="proj-rapincena">
          <a href="projetos/mobi_ric.html" class="proj-card__thumb" aria-label="Ver Rap In Cena">
            <img src="projetos/mobi_ric/Banner_MobiNoRIC_21_9.webp"
                 alt="Banner Rap In Cena" width="1260" height="540" loading="eager" class="proj-card__static" />
            <video class="proj-card__hover" muted loop playsinline aria-hidden="true">
              <source src="projetos/mobi_ric/Processo_06.webm" type="video/webm" />
            </video>
          </a>
          <div class="proj-card__body">
            <div class="proj-card__header">
              <h3 class="proj-card__title" id="proj-rapincena" data-en="Rap In Cena">Rap In Cena</h3>
              <span class="tag" data-en="Graph<br>Design">Desi<br>Graf</span>
            </div>
            <p class="proj-card__desc" data-en="Complete visual kit for Mobifans' participation in Brazil's biggest
              Hip-Hop festival.">
              Enxoval visual completo para a participação da Mobifans no maior festival
              de Hip-Hop do Brasil.
            </p>
            <div class="projeto__tech">
              <span class="tech-tag">Illustrator</span>
              <span class="tech-tag">Photoshop</span>
              <span class="tech-tag">CMYK</span>
            </div>
            <div class="proj-card__actions">
              <a href="projetos/mobi_ric.html" class="btn btn--primary" data-en="View project ↗">Ver projeto ↗</a>
            </div>
          </div>
        </article>

        <!-- Audiovisual Dia dos Namorados — Jun 2025 -->
        <article class="proj-card" data-cat="audiovisual" data-reveal data-reveal-delay="2" aria-labelledby="proj-dnamorados">
          <a href="projetos/mobi_namorados.html" class="proj-card__thumb" aria-label="Ver Audiovisual — Dia dos Namorados">
            <img src="projetos/mobi_namorados/Banner_Namorados_21_9.webp"
                 alt="Audiovisual — Campanha Dia dos Namorados" width="1260" height="540" loading="lazy" class="proj-card__static" />
            <video class="proj-card__hover" muted loop playsinline aria-hidden="true">
              <source src="projetos/mobi_namorados/Processo_02.webm" type="video/webm" />
            </video>
          </a>
          <div class="proj-card__body">
            <div class="proj-card__header">
              <h3 class="proj-card__title" id="proj-dnamorados" data-en="Audiovisual — Valentine's Day">Audiovisual — Dia dos Namorados</h3>
              <span class="tag" data-en="Audio<br>visual">Audi<br>visu</span>
            </div>
            <p class="proj-card__desc" data-en="Complete audiovisual production for Mobifans' Valentine's Day campaign:
              filming, editing and motion graphics.">
              Produção audiovisual completa para campanha de Dia dos Namorados da Mobifans:
              captação, edição e motion graphics.
            </p>
            <div class="projeto__tech">
              <span class="tech-tag">Premiere</span>
              <span class="tech-tag">After Effects</span>
            </div>
            <div class="proj-card__actions">
              <a href="projetos/mobi_namorados.html" class="btn btn--primary" data-en="View project ↗">Ver projeto ↗</a>
            </div>
          </div>
        </article>

        <!-- Cavaleiro de Latão — Jul 2024 -->
        <article class="proj-card" data-cat="3d" data-reveal aria-labelledby="proj-cavaleiro">
          <a href="projetos/cavaleiro_de_latao.html" class="proj-card__thumb" aria-label="Ver Cavaleiro de Latão">
            <img src="projetos/cavaleiro_de_latao/Banner_Cavaleiro_21_9.webp"
                 alt="Cavaleiro de Latão — roguelike autoral em Godot" width="1260" height="540" loading="lazy" class="proj-card__static" />
          </a>
          <div class="proj-card__body">
            <div class="proj-card__header">
              <h3 class="proj-card__title" id="proj-cavaleiro" data-en="Cavaleiro de Latão">Cavaleiro de Latão</h3>
              <span class="tag">3D</span>
            </div>
            <p class="proj-card__desc" data-en="Original roguelike developed in Godot with mixed 3D/2D art, Brazilian folklore as the enemy roster, and HTML5 export.">
              Roguelike autoral desenvolvido em Godot com arte mista 3D/2D, folclore brasileiro como galeria de inimigos e exportação HTML5.
            </p>
            <div class="projeto__tech">
              <span class="tech-tag">Godot</span>
              <span class="tech-tag">Blender</span>
              <span class="tech-tag">Aseprite</span>
            </div>
            <div class="proj-card__actions">
              <a href="projetos/cavaleiro_de_latao.html" class="btn btn--primary" data-en="View project ↗">Ver projeto ↗</a>
            </div>
          </div>
        </article>

        <!-- Projeto Vivências — Set–Nov 2023 -->
        <article class="proj-card" data-cat="design-grafico" data-reveal data-reveal-delay="1" aria-labelledby="proj-vivencias">
          <a href="projetos/unisenac_vivencias.html" class="proj-card__thumb" aria-label="Ver Projeto Vivências">
            <img src="projetos/unisenac_vivencias/Banner_Vivencias_21_9.webp"
                 alt="Capa do Projeto Vivências" width="1260" height="540" loading="lazy" />
          </a>
          <div class="proj-card__body">
            <div class="proj-card__header">
              <h3 class="proj-card__title" id="proj-vivencias" data-en="Vivências Project">Projeto Vivências</h3>
              <span class="tag" data-en="Graph<br> Design">Desi<br> Graf</span>
            </div>
            <p class="proj-card__desc" data-en="Visual identity developed for UniSenac's collaboration with RBS TV.
              Created by Multimedia Production students.">
              Identidade visual desenvolvida para a colaboração do UniSenac com a RBS TV.
              Desenvolvido por alunos de Produção Multimídia.
            </p>
            <div class="projeto__tech">
              <span class="tech-tag" data-en="Photography">Fotografia</span>
              <span class="tech-tag" data-en="Visual Identity">Identidade Visual</span>
            </div>
            <div class="proj-card__actions">
              <a href="projetos/unisenac_vivencias.html" class="btn btn--primary" data-en="View project ↗">Ver projeto ↗</a>
            </div>
          </div>
        </article>

        <!-- HackaTrânsito — Ago 2023 -->
        <article class="proj-card" data-cat="fotografia" data-reveal data-reveal-delay="2" aria-labelledby="proj-hackathon">
          <a href="https://www.instagram.com/unisenacrs/p/CwVGaW9O7M_/"
             target="_blank" rel="noopener noreferrer"
             class="proj-card__thumb" aria-label="Ver fotos no Instagram (abre em nova aba)">
            <img src="projetos/unisenac_hackathon/Banner_Hackathon_21_9.webp"
                 alt="Banner HackaTrânsito" width="1260" height="540" loading="lazy" />
          </a>
          <div class="proj-card__body">
            <div class="proj-card__header">
              <h3 class="proj-card__title" id="proj-hackathon" data-en="UniSenac Hackathon">Hackathon UniSenac</h3>
              <span class="tag" data-en="Photo<br>graphy">Foto<br>graf</span>
            </div>
            <p class="proj-card__desc" data-en="Staff participation with full photographic coverage of the event
              throughout the 24-hour hackathon.">
              Participação como Staff com cobertura fotográfica completa do evento
              ao longo das 24 horas de hackathon.
            </p>
            <div class="projeto__tech">
              <span class="tech-tag" data-en="Photography">Fotografia</span>
              <span class="tech-tag">Lightroom</span>
            </div>
            <div class="proj-card__actions">
              <a href="https://www.instagram.com/unisenacrs/p/CwVGaW9O7M_/"
                 target="_blank" rel="noopener noreferrer"
                 class="btn btn--primary" data-en="View photos ↗">Ver fotos ↗</a>
            </div>
          </div>
        </article>

        <!-- Foto Correio do Povo — 2023 -->
        <article class="proj-card" data-cat="fotografia" data-reveal data-reveal-delay="1" aria-labelledby="proj-correiodopovo">
          <a href="https://www.correiodopovo.com.br/notícias/ensino/vestibular/inverno/2023/senac-rs-teoria-prática-e-vida-profissional-em-foco-1.1037907"
