---
import Base from '../layouts/Base.astro';

const schemaLD = [
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "Filipe Velasco Duarte Delfino",
    "alternateName": "Filipe Duarte",
    "jobTitle": "Produtor Multimídia",
    "description": "Designer Multimídia com 4+ anos de experiência em identidade visual, produção gráfica e audiovisual. Adobe Certified. Porto Alegre, RS.",
    "url": "https://filipeduarte.netlify.app/",
    "email": "mailto:filipe.velascoduarte@gmail.com",
    "telephone": "+55-51-9-9605-1030",
    "image": "https://filipeduarte.netlify.app/img/og-image.jpg",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Gravataí",
      "addressRegion": "Rio Grande do Sul",
      "addressCountry": "BR"
    },
    "sameAs": [
      "https://www.linkedin.com/in/filipevelascoduarte",
      "https://www.behance.net/filipevelascoduarte"
    ],
    "knowsAbout": ["Design Gráfico","Produção Multimídia","UX/UI Design","Adobe Photoshop","Adobe Illustrator","Figma","Blender","JavaScript","Canvas API","IA Generativa"],
    "hasCredential": [
      { "@type": "EducationalOccupationalCredential", "name": "Adobe Certified Professional — Visual Design", "credentialCategory": "Certification" },
      { "@type": "EducationalOccupationalCredential", "name": "Claude 101 — Anthropic", "credentialCategory": "Certification" }
    ],
    "alumniOf": {
      "@type": "EducationalOrganization",
      "name": "Centro Universitário Senac",
      "address": { "@type": "PostalAddress", "addressLocality": "Porto Alegre", "addressRegion": "RS", "addressCountry": "BR" }
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "Filipe Duarte — Portfólio",
    "url": "https://filipeduarte.netlify.app/",
    "author": { "@type": "Person", "name": "Filipe Duarte" },
    "inLanguage": "pt-BR"
  }
];
---

<Base
  title="Filipe Duarte - Produtor Multimídia"
  description="Filipe Duarte - Produtor Multimídia. Design + Código + IA Generativa. Adobe Certified. Portfólio de projetos e experiências em Porto Alegre e Região Metropolitana"
  canonical="/"
  ogTitle="Filipe Duarte - Produtor Multimídia"
  ogDescription="Unindo Design, Código e IA Generativa de forma fluida. Adobe Certified. Nota 9,56/10. Porto Alegre e Região Metropolitana"
  schemaLD={schemaLD}
  preloadHeroImage={{
    href: "/img/webp/Banner_MobiStudio_Portfolio.webp",
    srcset: "/img/webp/Banner_MobiStudio_Portfolio_720.webp 720w, /img/webp/Banner_MobiStudio_Portfolio_1080.webp 1080w, /img/webp/Banner_MobiStudio_Portfolio.webp 1200w",
    sizes: "(max-width: 768px) 100vw, (max-width: 1240px) 50vw, 620px"
  }}
  extraPreloads={true}
  withContactFooter={false}
>

  <!-- HERO -->
  <section class="hero" id="hero" aria-labelledby="hero-title">
    <div class="container hero__inner">
      <div class="hero__content">

        <div class="hero__eyebrow">
          <span class="hero__status-dot" data-en="Open to opportunities">Disponível para oportunidades</span>
          <span class="tag tag--dark" data-en="Porto Alegre Metro Area">Porto Alegre e Região Metropolitana</span>
          <span class="tag">Adobe Certified ✦</span>
        </div>

        <h1 class="hero__headline" id="hero-title">
          <span class="sr-only" data-en="Filipe Duarte — Multimedia Producer">Filipe Duarte — Produtor Multimídia</span>
          <span id="lottie-hero-container" aria-hidden="true"></span>
        </h1>

        <div class="hero__roles">
          <span class="hero__role">3D</span>
          <span class="hero__role" data-en="Programming">Programação</span>
          <span class="hero__role">Design</span>
          <span class="hero__role">UX/UI</span>
          <span class="hero__role">Audiovisual</span>
        </div>

        <div class="hero__rating">
          <span class="tag" data-en="9.56 /10 internal review"><strong>9,56 /10</strong> em avaliação interna</span>
          <span class="tag tag--dark" data-en="4+ years of experience"><strong>4+</strong> anos de experiência</span>
        </div>

        <p class="hero__bio" data-i18n="hero-bio">
          com <strong>4+ anos</strong> de experiência. Atuo do briefing ao deploy,
          do Figma ao código funcional em produção.
          Uso <strong>IA generativa estrategicamente</strong>, não como tendência.
        </p>

        <div class="hero__actions">
          <a href="projetos.html" class="btn btn--primary" data-en="View Projects →">
            VER PROJETOS →
          </a>
          <a href="https://linkedin.com/in/filipevelascoduarte" target="_blank" rel="noopener noreferrer"
            class="btn btn--secondary">
            LINKEDIN ↗
          </a>
          <a href="https://behance.net/filipevelascoduarte" target="_blank" rel="noopener noreferrer"
            class="btn btn--yellow">
            BEHANCE ↗
          </a>
        </div>

      </div>
    </div>
    <span class="hero__decoration" aria-hidden="true">FD</span>
  </section>

  <!-- 01 — DESTAQUES (editorial alternating rows) -->
  <section class="destaques" id="destaques" aria-labelledby="destaques-title">
    <div class="container">
      <p class="section-label" data-en="01 — Featured Projects">01 — Destaques</p>
      <h2 class="sr-only" id="destaques-title" data-en="Featured projects">Projetos em destaque</h2>

      <div class="destaques__rows">

        <!-- MobiStudio — visual esquerda, info direita -->
        <article class="destaque-row" data-reveal aria-labelledby="dest-mobistudio">
          <div class="destaque-row__visual">
            <picture>
              <source type="image/webp"
                      srcset="img/webp/Banner_MobiStudio_Portfolio_720.webp 720w,
                              img/webp/Banner_MobiStudio_Portfolio_1080.webp 1080w,
                              img/webp/Banner_MobiStudio_Portfolio.webp 1200w"
                      sizes="(max-width: 768px) 100vw, (max-width: 1240px) 50vw, 620px" />
              <img src="img/webp/Banner_MobiStudio_Portfolio.webp"
                   alt="Banner MobiStudio — customizador interativo de capinhas"
                   width="1200" height="800" loading="eager" />
            </picture>
          </div>
          <div class="destaque-row__info">
            <div class="projeto__meta">
              <span class="tag tag--dark" data-en="Original Project">Projeto Autoral</span>
              <span class="tag" data-en="Web Dev">Dev Web</span>
            </div>
            <h3 class="destaque-row__title" id="dest-mobistudio">MobiStudio</h3>
            <p class="destaque-row__sub" data-en="Interactive Phone Case Customizer — v1.7.2">Customizador Interativo de Capinhas — v1.7.2</p>
            <p class="destaque-row__desc" data-en="Proprietary web tool for Mobifans kiosks to preview, in real time, the customer's photo applied to the case. Canvas API engine with zoom, rotation and drag. From problem to production deploy.">
              Ferramenta web proprietária para quiosques da Mobifans visualizarem, em tempo real, a foto do cliente aplicada à capinha. Motor Canvas API com zoom, rotação e arraste. Do problema ao deploy em produção.
            </p>
            <div class="projeto__tech">
              <span class="tech-tag">JavaScript</span>
              <span class="tech-tag">Canvas API</span>
              <span class="tech-tag">Figma</span>
              <span class="tech-tag">Builder.io</span>
              <span class="tech-tag">Netlify</span>
            </div>
            <div class="projeto__actions" style="margin-top: 0;">
              <a href="https://mobifans.netlify.app/" target="_blank" rel="noopener noreferrer"
                 class="btn btn--primary" data-en="Open MobiStudio ↗">Acessar MobiStudio ↗</a>
            </div>
          </div>
        </article>

        <!-- Rap In Cena — info esquerda, visual direita -->
        <article class="destaque-row destaque-row--reverse" data-reveal aria-labelledby="dest-rapincena">
          <div class="destaque-row__info">
            <div class="projeto__meta">
              <span class="tag tag--dark" data-en="Event Identity">Identidade de Evento</span>
              <span class="tag" data-en="Graphic Design">Design Gráfico</span>
            </div>
            <h3 class="destaque-row__title" id="dest-rapincena">Rap In Cena</h3>
            <p class="destaque-row__sub" data-en="Visual assets set — Brazil's largest Hip-Hop festival">Enxoval visual — Maior festival de Hip-Hop do Brasil</p>
            <p class="destaque-row__desc" data-en="Complete visual material for Mobifans' participation in Rap in Cena: from briefing to final file, covering every digital and physical touchpoint. One of the busiest stands at the event.">
              Material visual completo para a participação da Mobifans no Rap in Cena: do briefing ao arquivo final, cobrindo todos os pontos de contato digitais e físicos. Stand entre os mais movimentados do evento.
            </p>
            <div class="projeto__tech">
              <span class="tech-tag">Illustrator</span>
              <span class="tech-tag">Photoshop</span>
              <span class="tech-tag">Figma</span>
              <span class="tech-tag" data-en="CMYK / Printing">CMYK / Impressão</span>
            </div>
            <div class="projeto__actions" style="margin-top: 0;">
              <a href="https://www.behance.net/gallery/239019429/Mobifans-Rap-In-Cena"
                 target="_blank" rel="noopener noreferrer" class="btn btn--primary" data-en="View on Behance ↗">Ver no Behance ↗</a>
            </div>
          </div>
          <div class="destaque-row__visual">
            <picture>
              <source type="image/webp"
                      srcset="img/webp/Banner_MobiNoRIC_Portfolio_720.webp 720w,
                              img/webp/Banner_MobiNoRIC_Portfolio.webp 1200w"
                      sizes="(max-width: 768px) 100vw, (max-width: 1240px) 50vw, 620px" />
              <img src="img/webp/Banner_MobiNoRIC_Portfolio.webp"
                   alt="Banner Rap In Cena — identidade visual do festival"
                   width="1200" height="800" loading="lazy" />
            </picture>
          </div>
        </article>

      </div>

      <div style="text-align: center; margin-top: var(--space-10);">
        <a href="projetos.html" class="btn btn--secondary" data-en="View all projects →">Ver todos os projetos →</a>
      </div>

    </div>
  </section>

  <!-- 02 — STACK (marquee infinito) -->
  <section class="marquee-section" id="stack" aria-label="Stack de ferramentas">
    <div class="container">
      <p class="section-label marquee-section__label" data-en="02 — Tools & Stack">02 — Ferramentas & Stack</p>
    </div>

    <div class="marquee" aria-hidden="true">
      <div class="marquee__track">
        <!-- Set 1 -->
        <span class="marquee__item">
          <img src="https://skillicons.dev/icons?i=figma&theme=dark" alt="" loading="lazy" width="22" height="22">
          Figma
        </span>
        <span class="marquee__item">
          <img src="https://skillicons.dev/icons?i=ps&theme=dark" alt="" loading="lazy" width="22" height="22">
          Photoshop
        </span>
        <span class="marquee__item">
          <img src="https://skillicons.dev/icons?i=ai&theme=dark" alt="" loading="lazy" width="22" height="22">
          Illustrator
        </span>
        <span class="marquee__item">
          <img src="https://skillicons.dev/icons?i=ae&theme=dark" alt="" loading="lazy" width="22" height="22">
          After Effects
        </span>
        <span class="marquee__item">
          <img src="https://skillicons.dev/icons?i=pr&theme=dark" alt="" loading="lazy" width="22" height="22">
          Premiere
        </span>
        <span class="marquee__item">
          <img src="https://skillicons.dev/icons?i=blender&theme=dark" alt="" loading="lazy" width="22" height="22">
          Blender
        </span>
        <span class="marquee__item">
          <img src="https://skillicons.dev/icons?i=js&theme=dark" alt="" loading="lazy" width="22" height="22">
          JavaScript
        </span>
        <span class="marquee__item">
          <img src="https://skillicons.dev/icons?i=html&theme=dark" alt="" loading="lazy" width="22" height="22">
          HTML / CSS
        </span>
        <span class="marquee__item">
          <img src="https://cdn.simpleicons.org/anthropic/D97757" alt="" loading="lazy" width="22" height="22">
          Claude
        </span>
        <span class="marquee__item">
          <img src="https://cdn.builder.io/api/v1/image/assets%2FYJIGb4i01jvw0SRdL5Bt%2F470aa2bd45fb4ff5b77c91a394a957e6"
          alt="" loading="lazy" width="22" height="22">
          Builder.io
        </span>
        <span class="marquee__item">
          <img src="https://cavalry.studio/favicon.svg" alt="" loading="lazy" width="22" height="22">
          Cavalry
        </span>
        <span class="marquee__item">
          <span class="marquee__glyph">⊡</span>
          Canvas API
        </span>
        <!-- Set 2 — duplicate for seamless loop -->
        <span class="marquee__item">
          <img src="https://skillicons.dev/icons?i=figma&theme=dark" alt="" loading="lazy" width="22" height="22">
          Figma
        </span>
        <span class="marquee__item">
          <img src="https://skillicons.dev/icons?i=ps&theme=dark" alt="" loading="lazy" width="22" height="22">
          Photoshop
        </span>
        <span class="marquee__item">
          <img src="https://skillicons.dev/icons?i=ai&theme=dark" alt="" loading="lazy" width="22" height="22">
          Illustrator
        </span>
        <span class="marquee__item">
          <img src="https://skillicons.dev/icons?i=ae&theme=dark" alt="" loading="lazy" width="22" height="22">
          After Effects
        </span>
        <span class="marquee__item">
          <img src="https://skillicons.dev/icons?i=pr&theme=dark" alt="" loading="lazy" width="22" height="22">
          Premiere
        </span>
        <span class="marquee__item">
          <img src="https://skillicons.dev/icons?i=blender&theme=dark" alt="" loading="lazy" width="22" height="22">
          Blender
        </span>
        <span class="marquee__item">
          <img src="https://skillicons.dev/icons?i=js&theme=dark" alt="" loading="lazy" width="22" height="22">
          JavaScript
        </span>
        <span class="marquee__item">
          <img src="https://skillicons.dev/icons?i=html&theme=dark" alt="" loading="lazy" width="22" height="22">
          HTML / CSS
        </span>
        <span class="marquee__item">
          <img src="https://cdn.simpleicons.org/anthropic/D97757" alt="" loading="lazy" width="22" height="22">
          Claude
        </span>
        <span class="marquee__item">
          <img src="https://cdn.builder.io/api/v1/image/assets%2FYJIGb4i01jvw0SRdL5Bt%2F470aa2bd45fb4ff5b77c91a394a957e6"
          alt="" loading="lazy" width="22" height="22">
          Builder.io
        </span>
        <span class="marquee__item">
          <img src="https://cavalry.studio/favicon.svg" alt="" loading="lazy" width="22" height="22">
          Cavalry
        </span>
        <span class="marquee__item">
          <span class="marquee__glyph">⊡</span>
          Canvas API
        </span>
      </div>
    </div>
  </section>

  <!-- 03 — RECOMENDAÇÃO (pull-quote) -->
  <section class="quote-section" id="recomendacao" aria-labelledby="quote-title">
    <div class="container">
      <p class="section-label" data-en="03 — Recommendation">03 — Recomendação</p>

      <div class="pull-quote" data-reveal>
        <span class="pull-quote__mark" aria-hidden="true">"</span>
        <p class="pull-quote__text" id="quote-title" data-en="Filipe was the best person I've ever worked with, a dedicated professional always eager to learn more! Exceptional in everything he sets out to do and incredibly talented at everything he does!">
          Filipe foi a melhor pessoa com quem já trabalhei, profissional dedicado e sempre disposto a aprender mais! Excepcional em tudo que se propõe a fazer e é incrivelmente talentoso em tudo que faz!
        </p>
        <div class="pull-quote__footer">
          <div class="pull-quote__author">
            <span class="pull-quote__name">Kamila Oliveira</span>
            <span class="pull-quote__role" data-en="Graphic Design · UX/UI Designer · Teammate (Sep/2025)">Design Gráfico · UX/UI Designer · Colega de equipe (set/2025)</span>
          </div>
          <a href="sobre.html#recomendacoes" class="pull-quote__link" data-en="All recommendations →">
            Ver todas as recomendações →
          </a>
        </div>
      </div>

    </div>
  </section>

  <!-- CONTATO -->
  <section class="contato" id="contato" aria-labelledby="contato-title">
    <div class="container">
      <p class="section-label" data-en="04 — Contact">04 — Contato</p>

      <div class="contato__inner">

        <div data-reveal>
          <h2 class="contato__heading" id="contato-title" data-i18n="contato-heading">
            Vamos criar<br />algo <span class="highlight">juntos?</span>
          </h2>
          <p class="contato__subtext" data-i18n="contato-subtext">
            Estou disponível para novas oportunidades como CLT, freelance ou projetos colaborativos.
            Se você precisa de alguém que trabalha do conceito ao produto finalizado, me chama!
          </p>
          <div class="contato__available" aria-label="Modalidades de trabalho disponíveis">
            <span class="available-badge" data-en="On-site">Presencial</span>
            <span class="available-badge" data-en="Hybrid">Híbrido</span>
            <span class="available-badge">Freelance</span>
          </div>
        </div>

        <ul class="contato__links" data-reveal data-reveal-delay="2" aria-label="Canais de contato">
          <li>
            <a class="contact-link" href="mailto:filipe.velascoduarte@gmail.com"
              aria-label="Enviar e-mail para Filipe Duarte">
              <span class="contact-link__icon" aria-hidden="true">✉️</span>
              <div>
                <p class="contact-link__label" data-en="Email">E-mail</p>
                <p class="contact-link__value">filipe.velascoduarte@gmail.com</p>
              </div>
              <span class="contact-link__arrow" aria-hidden="true">→</span>
            </a>
          </li>
          <li>
            <a class="contact-link" href="https://wa.me/5551996051030" target="_blank" rel="noopener noreferrer"
              aria-label="Abrir WhatsApp de Filipe Duarte">
              <span class="contact-link__icon" aria-hidden="true">💬</span>
              <div>
                <p class="contact-link__label" data-en="Get in touch">Entre em contato</p>
                <p class="contact-link__value">WhatsApp</p>
              </div>
              <span class="contact-link__arrow" aria-hidden="true">→</span>
            </a>
          </li>
          <li>
            <a class="contact-link" href="https://www.linkedin.com/in/filipe-velasco/" target="_blank"
              rel="noopener noreferrer" aria-label="Perfil LinkedIn de Filipe Duarte">
              <span class="contact-link__icon" aria-hidden="true">💼</span>
              <div>
                <p class="contact-link__label">LinkedIn</p>
                <p class="contact-link__value">linkedin.com/in/filipevelascoduarte</p>
              </div>
              <span class="contact-link__arrow" aria-hidden="true">→</span>
            </a>
          </li>
          <li>
            <a class="contact-link" href="https://behance.net/filipevelascoduarte" target="_blank"
              rel="noopener noreferrer" aria-label="Portfólio Behance de Filipe Duarte">
              <span class="contact-link__icon" aria-hidden="true">🎨</span>
              <div>
                <p class="contact-link__label">Behance</p>
                <p class="contact-link__value">behance.net/filipevelascoduarte</p>
              </div>
              <span class="contact-link__arrow" aria-hidden="true">→</span>
            </a>
          </li>
        </ul>

      </div>
    </div>
  </section>

</Base>
