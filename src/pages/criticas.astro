---
import Base from '../layouts/Base.astro';
import archiveData from '../data/letterboxd-archive.json';

// ── Film interface ────────────────────────────────────────────────────────
const RSS_URL = 'https://letterboxd.com/pipo_criticas/rss/';

interface Film {
  guid:       string;
  filmTitle:  string;
  filmYear:   string;
  rating:     number;
  watched:    string;   // YYYY-MM-DD
  month:      string;   // YYYY-MM
  rewatch:    boolean;
  like:       boolean;
  link:       string;
  poster:     string;
  reviewHtml: string;   // cleaned CDATA (poster img + spoiler notice stripped)
  hasSpoiler: boolean;
  director?:  string;
}

function decodeHtml(s: string): string {
  return s
    .replace(/&amp;/g, '&').replace(/&lt;/g, '<').replace(/&gt;/g, '>')
    .replace(/&quot;/g, '"').replace(/&#039;/g, "'").replace(/&apos;/g, "'");
}

function starsHTML(r: number): string {
  const full = Math.floor(r);
  const half = (r - full) >= 0.5;
  const off  = 5 - full - (half ? 1 : 0);
  let s = '★'.repeat(full);
  if (half) s += '<span class="cd-stars-half">½</span>';
  if (off > 0) s += `<span class="cd-stars-off">${'★'.repeat(off)}</span>`;
  return `<span class="cd-stars">${s}</span>`;
}

function fmtRating(r: number): string {
  return r.toFixed(1).replace('.', ',').replace(',0', '');
}

// ── 1. Seed the map from the static archive (all known films) ─────────────
// Key: "normalised-title|watchedDate" — stable across RSS and CSV sources.
const filmMap = new Map<string, Film>();
for (const raw of archiveData as Film[]) {
  const f = { ...raw };
  if (!f.director && f.reviewHtml) {
    const m = f.reviewHtml.match(/Dire[çc][ãa]o:\s*([^<\r\n]+)/i);
    f.director = m ? m[1].trim() : undefined;
  }
  filmMap.set(`${f.filmTitle.toLowerCase()}|${f.watched}`, f);
}

// ── 2. Overlay fresh RSS data (most recent entries, may have edits) ───────
try {
  const res = await fetch(RSS_URL, { headers: { 'User-Agent': 'Mozilla/5.0' } });
  const xml = await res.text();

  const itemRe = /<item>([\s\S]*?)<\/item>/g;
  let m: RegExpExecArray | null;
  while ((m = itemRe.exec(xml)) !== null) {
    const it = m[1];
    const lbx = (tag: string) =>
      it.match(new RegExp(`<letterboxd:${tag}>([\\s\\S]*?)<\\/letterboxd:${tag}>`))?.[1]?.trim() ?? '';

    const watched = lbx('watchedDate');
    if (!watched) continue;

    const cdata      = it.match(/<!\[CDATA\[([\s\S]*?)\]\]>/)?.[1] ?? '';
    const poster     = cdata.match(/src="(https:\/\/a\.ltrbxd\.com[^"]+)"/)?.[1] ?? '';
    const hasSpoiler = cdata.includes('This review may contain spoilers');

    const dirMatch   = cdata.match(/Dire[çc][ãa]o:\s*([^<]+)/i);
    const director   = dirMatch ? dirMatch[1].trim() : 'Não informada';

    const reviewHtml = cdata
      .replace(/<p>\s*<img[^>]*>\s*<\/p>/g, '')
      .replace(/<p>\s*<em>This review may contain spoilers\.<\/em>\s*<\/p>/g, '')
      .replace(/<p>Dire[çc][ãa]o:[^<]*<\/p>/gi, '')
      .replace(/Dire[çc][ãa]o:[^<]*<br\s*\/?>/gi, '')
      .trim();

    const rStr = lbx('memberRating');
    const link = it.match(/<link>(https:\/\/letterboxd\.com[^<]+)<\/link>/)?.[1] ?? '';
    const guid = it.match(/<guid[^>]*>([^<]+)<\/guid>/)?.[1]?.trim() ?? '';

    const film: Film = {
      guid,
      filmTitle:  decodeHtml(lbx('filmTitle')),
      filmYear:   lbx('filmYear'),
      rating:     rStr ? parseFloat(rStr) : 0,
      watched,
      month:      watched.slice(0, 7),
      rewatch:    lbx('rewatch') === 'Yes',
      like:       lbx('memberLike') === 'Yes',
      link,
      poster,
      reviewHtml,
      hasSpoiler,
      director,
    };
    // RSS always wins — it may contain updated reviews/ratings
    filmMap.set(`${film.filmTitle.toLowerCase()}|${film.watched}`, film);
  }
} catch (_) { /* RSS unavailable — keep archive data only */ }

// ── 3. Build sorted list ──────────────────────────────────────────────────
let allFilms: Film[] = Array.from(filmMap.values());

// newest-first
allFilms.sort((a, b) => b.watched.localeCompare(a.watched));

// ── Statistics ────────────────────────────────────────────────────────────
const rated    = allFilms.filter(f => f.rating > 0);
const avgGlobal = rated.length
  ? (rated.reduce((s, f) => s + f.rating, 0) / rated.length).toFixed(1).replace('.', ',')
  : '—';

// ── Destaques (rating ≥ 4,5) ─────────────────────────────────────────────
const destaques = allFilms
  .filter(f => f.rating >= 4.5)
  .sort((a, b) => {
    const scoreA = a.rating + (a.like ? 0.5 : 0);
    const scoreB = b.rating + (b.like ? 0.5 : 0);
    return scoreB - scoreA || b.watched.localeCompare(a.watched);
  });

// ── Monthly groups ────────────────────────────────────────────────────────
const MONTHS_PT: Record<string, string> = {
  '01':'Janeiro','02':'Fevereiro','03':'Março','04':'Abril',
  '05':'Maio','06':'Junho','07':'Julho','08':'Agosto',
  '09':'Setembro','10':'Outubro','11':'Novembro','12':'Dezembro',
};

function monthLabel(ym: string): string {
  const [yr, mo] = ym.split('-');
  return `${MONTHS_PT[mo] ?? mo} / ${yr.slice(2)}`;
}

function detectMarathon(films: Film[]): string | null {
  if (films.length < 5) return null;
  const watchYear = films[0]?.watched.slice(0, 4) ?? '';
  const cnt: Record<string, number> = {};
  for (const f of films) { if (f.filmYear) cnt[f.filmYear] = (cnt[f.filmYear] ?? 0) + 1; }
  for (const [yr, n] of Object.entries(cnt)) {
    if (yr !== watchYear && n >= films.length * 0.7) return yr;
  }
  return null;
}

interface MonthGroup {
  ym:        string;
  label:     string;
  films:     Film[];
  marathon:  string | null;  // marathon year, e.g. '2002'
  avgRating: string;
}

const months: MonthGroup[] = Array.from(
  allFilms.reduce((map, f) => {
    if (!map.has(f.month)) map.set(f.month, []);
    map.get(f.month)!.push(f);
    return map;
  }, new Map<string, Film[]>())
)
  .sort(([a], [b]) => b.localeCompare(a))
  .map(([ym, films]) => {
    const r  = films.filter(f => f.rating > 0);
    const avg = r.length
      ? (r.reduce((s, f) => s + f.rating, 0) / r.length).toFixed(1).replace('.', ',')
      : '—';
    return { ym, label: monthLabel(ym), films, marathon: detectMarathon(films), avgRating: avg };
  });

// ── Review payload for modal (embedded JSON) ──────────────────────────────
type ReviewPayload = {
  title: string; year: string; month: string; rating: number;
  reviewHtml: string; poster: string; link: string;
  rewatch: boolean; hasSpoiler: boolean; director?: string;
};
const reviewData: Record<string, ReviewPayload> = {};
for (const f of allFilms) {
  if (f.guid) reviewData[f.guid] = {
    title: f.filmTitle, year: f.filmYear, month: monthLabel(f.month),
    rating: f.rating, reviewHtml: f.reviewHtml, poster: f.poster,
    link: f.link, rewatch: f.rewatch, hasSpoiler: f.hasSpoiler,
    director: f.director,
  };
}

const totalMaratonas = months.filter(m => m.marathon).length;
---

<Base
  title="Diário de Cinema — Filipe Duarte"
  description="Críticas e análises de cinema importadas do Letterboxd. Diário cinematográfico de Filipe Duarte."
  canonical="/criticas.html"
  withContactFooter={false}
>

<div class="cd-page">

  <div class="cd-wrap">

    <nav class="cd-category-nav" aria-label="Menu do Repertório">
      <a href="/criticas" class="cd-cat-item is-active" data-en="Cinema">Cinema</a>
      <span class="cd-cat-item is-disabled" data-en={`Series <span class="cd-cat-soon">(Coming soon)</span>`}>Séries <span class="cd-cat-soon">(Em breve)</span></span>
      <span class="cd-cat-item is-disabled" data-en={`Music <span class="cd-cat-soon">(Coming soon)</span>`}>Músicas <span class="cd-cat-soon">(Em breve)</span></span>
      <span class="cd-cat-item is-disabled" data-en={`Games <span class="cd-cat-soon">(Coming soon)</span>`}>Jogos <span class="cd-cat-soon">(Em breve)</span></span>
    </nav>

    <!-- PAGE HEAD -->
    <div class="cd-pagehead">
      <div class="cd-eyebrow" data-en="Cinema Diary · since Jan / 2026">Diário de Cinema · desde Jan / 2026</div>
      <h1 class="cd-hero" data-en={`CINEMA<br /><span class="cd-stroke">DIARY</span>`}>DIÁRIO DE<br /><span class="cd-stroke">CINEMA</span></h1>
      <p class="cd-lead" data-en={`My reviews and analyses imported from Letterboxd. The <b>highlights</b> open the
        reading; the rest is organized <b>chronologically by month</b>, in an immersive grid
        of posters.`}>
        Minhas críticas e análises importadas do Letterboxd. Os <b>destaques</b> abrem a
        leitura; o restante é organizado <b>cronologicamente por mês</b>, em grid imersivo
        de pôsteres.
      </p>
      <div class="cd-summary">
        <div class="cd-stat">
          <div class="cd-stat__v">{allFilms.length}</div>
          <div class="cd-stat__l" data-en="Films logged">Filmes registrados</div>
        </div>
        <div class="cd-stat">
          <div class="cd-stat__v"><span class="cd-pink">★</span> {avgGlobal}</div>
          <div class="cd-stat__l" data-en="Average rating">Nota média</div>
        </div>
        <div class="cd-stat">
          <div class="cd-stat__v">{months.length}</div>
          <div class="cd-stat__l" data-en="Months logged">Meses registrados</div>
        </div>
        <div class="cd-stat">
          <div class="cd-stat__v">{totalMaratonas}</div>
          <div class="cd-stat__l">{totalMaratonas === 1 ? 'Maratona' : 'Maratonas'} concluída{totalMaratonas !== 1 ? 's' : ''}</div>
        </div>
      </div>

    </div>

    <!-- ════════════════════════════════════════════════════════
         SECTION 01 — DESTAQUES
         ════════════════════════════════════════════════════════ -->
    <div id="destaques"></div>
    <div class="cd-section-label">
      <span class="cd-sl-ix">01</span>
      <h2 class="cd-sl-h2" data-en="Highlights · Top Rated">Destaques · Top Rated</h2>
      <span class="cd-sl-rule"></span>
      <span class="cd-sl-aside" data-en="★ 4.5 and above · open reading">★ 4,5 e acima · leitura aberta</span>
    </div>

    {destaques.length === 0 && (
      <p class="cd-meta" style="margin:var(--space-8) 0; color:var(--color-muted)" data-en="No highlights yet — films with ★ 4.5+ will appear here.">
        Nenhum destaque ainda — filmes com ★ 4,5+ aparecerão aqui.
      </p>
    )}

    <div class="cd-carousel-wrap">
      <button class="cd-carousel-btn cd-carousel-btn--prev" id="cdCarouselPrev" aria-label="Anterior">&#8592;</button>
      <div class="cd-carousel-viewport">
      <div class="cd-featured-stack" id="cdFeaturedStack">
      {destaques.map((f) => (
        <article class="cd-featured"
          data-guid={f.guid}
          role="button"
          tabindex="0"
          aria-label={`Ler crítica de ${f.filmTitle}`}
        >
          <!-- Stars badge — top left -->
          <div class="cd-badge-stars" set:html={starsHTML(f.rating)} />

          <!-- Like badge — top right (conditional) -->
          {f.like && (
            <div class="cd-badge-like" aria-label="Marcado como favorito">♥</div>
          )}

          <!-- Poster -->
          {f.poster
            ? <img class="cd-poster-real" src={f.poster} alt={`Pôster de ${f.filmTitle}`} width="294" height="437" loading="lazy" />
            : <div class="cd-poster" aria-label="Pôster"></div>
          }

          <!-- Footer -->
          <div class="cd-featured__footer">
            <h3 class="cd-featured-title">{f.filmTitle}</h3>
            <div class="cd-featured-meta-grid">
              <span data-en="WATCHED ON">VISTO EM</span><span>{monthLabel(f.month)}</span>
              <span data-en="DIRECTION">DIREÇÃO</span><span>{f.director ?? 'Não informada'}</span>
            </div>
          </div>
        </article>
      ))}
      </div>
      </div><!-- .cd-carousel-viewport -->
      <button class="cd-carousel-btn cd-carousel-btn--next" id="cdCarouselNext" aria-label="Próximo">&#8594;</button>
    </div>

    <!-- ════════════════════════════════════════════════════════
         SECTION 02 — LISTAGEM POR MÊS
         ════════════════════════════════════════════════════════ -->
    <div id="listagem"></div>
    <div class="cd-section-label">
      <span class="cd-sl-ix">02</span>
      <h2 class="cd-sl-h2" data-en="Listing by Month">Listagem por Mês</h2>
      <span class="cd-sl-rule"></span>
      <span class="cd-sl-aside" data-en="Immersive grid · 4 columns · 2:3">Grid imersivo · 4 colunas · 2:3</span>
    </div>

    {months.map((m) => {
      // For marathon months: sort films by watched asc (chronological) and add seq
      const marathonFilms = m.marathon
        ? [...m.films].sort((a, b) => a.watched.localeCompare(b.watched))
        : m.films;

      return (
        <section class="cd-month">
          <div class="cd-month__head">
            <div class="cd-month__m">
              <h3>{m.label}</h3>
              <span class="cd-month__sub">
                {m.marathon
                  ? `Maratona · filmes de ${m.marathon}`
                  : 'Lançamentos & catálogo'}
              </span>
            </div>
            {m.marathon && (
              <span class="cd-badge-marathon">
                Desafio: filmes de {m.marathon}
              </span>
            )}
            <div class="cd-month__agg">
              <div class="cd-stat">
                <div class="cd-stat__v">{m.films.length}</div>
                <div class="cd-stat__l" data-en="Films">Filmes</div>
              </div>
              <div class="cd-stat">
                <div class="cd-stat__v">★ {m.avgRating}</div>
                <div class="cd-stat__l" data-en="Average">Média</div>
              </div>
            </div>
          </div>

          <div class="cd-mgrid">
            {marathonFilms.map((f, idx) => (
              <div class="cd-gcard"
                data-guid={f.guid}
                role="button"
                tabindex="0"
                aria-label={`Ver crítica de ${f.filmTitle}`}
              >
                {m.marathon && (
                  <span class="cd-seq">{String(idx + 1).padStart(2, '0')}</span>
                )}

                <!-- Poster -->
                <div class="cd-gcard__poster-wrap">
                  {f.poster
                    ? <img class="cd-gcard__img" src={f.poster}
                        alt={`Pôster de ${f.filmTitle}`} width="300" height="450" loading="lazy" />
                    : <div class="cd-poster cd-poster--sm"></div>
                  }
                  <div class="cd-overlay" aria-hidden="true">
                    <span set:html={starsHTML(f.rating)} />
                    <span class="cd-cue" data-en="Read review →">Ler crítica →</span>
                  </div>
                </div>

                <div class="cd-gcap">
                  <span class="cd-titleline">{f.filmTitle}</span>
                  <span class="cd-meta">{f.filmYear} · {fmtRating(f.rating)} ★</span>
                </div>
              </div>
            ))}
          </div>
        </section>
      );
    })}

    <div class="cd-foot">
      <span class="cd-meta" data-en={`Cinema Diary · Filipe Duarte · <a href="https://letterboxd.com/pipo_criticas/" target="_blank" rel="noopener noreferrer" style="color:inherit; text-decoration:underline">letterboxd.com/pipo_criticas</a>`}>
        Diário de Cinema · Filipe Duarte ·
        <a href="https://letterboxd.com/pipo_criticas/" target="_blank" rel="noopener noreferrer"
           style="color:inherit; text-decoration:underline">letterboxd.com/pipo_criticas</a>
      </span>
    </div>
  </div><!-- .cd-wrap -->
</div><!-- .cd-page -->

<!-- ══════════════════════════════════════════════════════════
     MODAL
     ══════════════════════════════════════════════════════════ -->
<div class="cd-modal-back" id="cdModalBack" role="presentation">
  <div class="cd-modal" id="cdModal" role="dialog" aria-modal="true" aria-labelledby="cdMdTitle">
    <div class="cd-modal__bar">
      <span id="cdMdMonth" class="cd-modal__bar-label">Crítica</span>
      <button class="cd-modal__close" id="cdModalClose" aria-label="Fechar modal">✕</button>
    </div>
    <div class="cd-modal__in">
      <div class="cd-modal__top">
        <img class="cd-modal__poster" id="cdMdPoster" src="" alt="" width="150" height="225" />
        <div>
          <div class="cd-titleline cd-titleline--xl" id="cdMdTitle">—</div>
          <div class="cd-meta" id="cdMdYear" style="margin-top:var(--space-2)">—</div>
          <div class="cd-meta" id="cdMdDirector" style="margin-top:var(--space-1); color:var(--color-muted)">—</div>
          <div id="cdMdStars" style="margin-top:var(--space-3); font-size:1.2em"></div>
          <div id="cdMdBadges" style="margin-top:var(--space-3); display:flex; gap:var(--space-2); flex-wrap:wrap;"></div>
        </div>
      </div>
      <div id="cdMdSpoiler" class="cd-spoiler-notice" style="display:none" data-en="⚠ This review may contain spoilers.">
        ⚠ Esta crítica pode conter spoilers.
      </div>
      <div class="cd-modal__review" id="cdMdReview"></div>
      <div class="cd-modal__cta">
        <span class="cd-modal__note" data-en="Opens the original post on Letterboxd">Abre a publicação original no Letterboxd</span>
        <a class="cd-btn-lb" id="cdMdLink" href="#" target="_blank" rel="noopener noreferrer" data-en={`<span class="cd-btn-lb__dots"><i></i><i></i><i></i></span>
          View on Letterboxd ↗`}>
          <span class="cd-btn-lb__dots"><i></i><i></i><i></i></span>
          Ver no Letterboxd ↗
        </a>
      </div>
    </div>
  </div>
</div>

<!-- Review payload (build-time JSON, no runtime fetch needed) -->
<script type="application/json" id="cdReviewData" set:html={JSON.stringify(reviewData)} />

</Base>

<!-- ══════════════════════════════════════════════════════════
     STYLES
     ══════════════════════════════════════════════════════════ -->
<style is:global>
  /* ── Local tokens ─────────────────────────────────────────────────────── */
  .cd-page {
    --cd-hatch: color-mix(in srgb, var(--color-ink) 9%, transparent);
    --cd-placeholder: color-mix(in srgb, var(--color-ink) 7%, var(--color-bg));
    --cd-sk: color-mix(in srgb, var(--color-ink) 13%, var(--color-bg));
    padding-top: 60px;
  }

  /* ── Category nav ─────────────────────────────────────────────────────── */
  .cd-category-nav {
    display: flex; gap: var(--space-6);
    padding: var(--space-8) 0 var(--space-4);
    border-bottom: 2px solid var(--color-ink);
    margin-bottom: var(--space-8); flex-wrap: wrap;
  }
  .cd-cat-item {
    font-family: var(--font-mono); font-weight: 700;
    font-size: clamp(0.75rem, 1.5vw, 0.875rem); letter-spacing: 0.08em;
    text-transform: uppercase; color: var(--color-ink); text-decoration: none;
    padding-bottom: var(--space-2); border-bottom: 4px solid transparent;
    cursor: pointer; transition: all 0.2s ease;
  }
  .cd-cat-item.is-active { border-bottom-color: var(--color-pink); }
  .cd-cat-item:not(.is-disabled):hover { color: var(--color-pink); border-bottom-color: var(--color-pink); }
  .cd-cat-item.is-disabled { color: var(--color-muted); cursor: not-allowed; opacity: 0.7; }
  .cd-cat-soon { font-size: 0.8em; margin-left: 4px; font-weight: 400; }

  /* ── Wrap ─────────────────────────────────────────────────────────────── */
  .cd-wrap { max-width: 1280px; margin: 0 auto; padding: 0 var(--space-5); }

  /* ── Page head ────────────────────────────────────────────────────────── */
  .cd-pagehead {
    padding: 0 0 var(--space-12);
    border-bottom: 3px solid var(--color-ink);
  }
  .cd-eyebrow {
    display: flex; align-items: center; gap: var(--space-3);
    font-family: var(--font-mono); font-weight: 700;
    font-size: clamp(.75rem,1.5vw,.875rem); letter-spacing: .12em;
    text-transform: uppercase; color: var(--color-muted); margin-bottom: var(--space-5);
  }
  .cd-eyebrow::before { content:""; width:48px; height:2px; background:var(--color-ink); flex-shrink:0; }
  .cd-hero {
    font-family: var(--font-display); font-weight: 800; text-transform: uppercase;
    letter-spacing: -.04em; line-height: .92; margin: 0;
    font-size: clamp(2.5rem, 8vw, 6rem);
  }
  .cd-stroke { -webkit-text-stroke: 2.5px var(--color-ink); color: transparent; }
  .cd-lead {
    max-width: 60ch; margin: var(--space-5) 0 0;
    font-size: clamp(1rem,2vw,1.125rem); line-height: 1.7; color: var(--color-muted);
  }
  .cd-lead b { color: var(--color-ink); font-weight: 600; }
  .cd-summary { display: flex; gap: var(--space-6); margin-top: var(--space-8); flex-wrap: wrap; }
  .cd-stat__v {
    font-family: var(--font-display); font-weight: 800;
    font-size: clamp(1.75rem,3.5vw,2.5rem); line-height: 1;
  }
  .cd-stat__l {
    font-family: var(--font-mono); font-weight: 700; font-size: 10px;
    letter-spacing: .06em; text-transform: uppercase; color: var(--color-muted); margin-top: 4px;
  }
  .cd-pink { color: var(--color-pink); }

  /* ── Section label ────────────────────────────────────────────────────── */
  .cd-section-label {
    display: flex; align-items: center; gap: var(--space-4);
    margin: var(--space-20) 0 var(--space-8);
  }
  .cd-sl-ix {
    font-family: var(--font-mono); font-weight: 700;
    font-size: clamp(.75rem,1.5vw,.875rem); letter-spacing: .06em; color: var(--color-pink);
  }
  .cd-sl-h2 {
    font-family: var(--font-display); font-weight: 800; text-transform: uppercase;
    letter-spacing: -.02em; font-size: clamp(1.75rem,3.5vw,2.5rem); margin: 0; white-space: nowrap;
  }
  .cd-sl-rule { flex: 1; height: 2px; background: var(--color-ink); }
  .cd-sl-aside {
    font-family: var(--font-mono); font-weight: 700;
    font-size: clamp(.75rem,1.5vw,.875rem); letter-spacing: .06em;
    text-transform: uppercase; color: var(--color-muted); white-space: nowrap;
  }

  /* ── Shared primitives ────────────────────────────────────────────────── */
  .cd-poster {
    position: relative; border: 3px solid var(--color-ink);
    background:
