---
import CaseStudy from '../../layouts/CaseStudy.astro';
---

<CaseStudy
  caseTitle="Audiovisual — Dia dos Namorados"
  caseDesc="Produção audiovisual completa para campanha de Dia dos Namorados da Mobifans: captação, edição e motion graphics."
  casePath="/projetos/mobi_namorados.html"
  ogImage="/projetos/mobi_namorados/Banner_Namorados_21_9.webp"
  heroImageHref="/projetos/mobi_namorados/Banner_Namorados_21_9.webp"
>

  <!-- BREADCRUMB -->
  <div class="case-breadcrumb">
    <div class="container case-breadcrumb__inner">
      <a class="case-breadcrumb__link" href="../projetos.html" data-en="← Projects">← Projetos</a>
      <span class="case-breadcrumb__sep">·</span>
      <span class="case-breadcrumb__current" data-en="Case">Case</span>
    </div>
  </div>

  <!-- CASE HEADER -->
  <section class="case-header" aria-labelledby="case-title">
    <div class="container">
      <p class="case-header__eyebrow" data-en="Case · Audiovisual · Client">
        Case · Audiovisual · Mobifans
      </p>
      <h1 class="case-header__title" id="case-title">
        Dia dos<br />Namorados.
      </h1>
      <div class="case-header__meta">
        <span class="case-header__date" data-en="Jun 2026">Jun 2026</span>
        <div class="case-header__tags">
          <span class="tech-tag">Premiere Pro</span>
          <span class="tech-tag">After Effects</span>
          <span class="tech-tag">Captação</span>
          <span class="tech-tag">Motion Graphics</span>
        </div>
      </div>
    </div>
  </section>

  <!-- HERO DO CASE -->
  <div class="case-hero" role="img" aria-label="Banner da campanha Dia dos Namorados — Mobifans">
    <img class="case-hero__img" src="/projetos/mobi_namorados/Banner_Namorados_21_9.webp"
         alt="Audiovisual Dia dos Namorados — campanha Mobifans" width="2100" height="900" loading="eager" />
  </div>

  <!-- 01 — CONTEXTO / PROBLEMA -->
  <section class="case-section" aria-labelledby="ctx-title">
    <div class="container">
      <div class="case-section__header">
        <p class="section-label" id="ctx-title" data-en="01 — Context / Problem">01 — Contexto / Problema</p>
        <span class="case-section__note" data-en="campaign · 4 videos · 7 days">campanha · 4 vídeos · 7 dias</span>
      </div>
      <div class="case-grid-2" data-reveal>
        <div>
          <p style="font-size: var(--text-base); line-height: 1.75; color: var(--color-muted); margin-bottom: var(--space-6);">
            Para o <strong style="color: var(--color-ink);">Dia dos Namorados 2026</strong>, a Mobifans precisava de uma campanha audiovisual completa — com captação, edição e motion graphics — publicada em sequência ao longo de uma semana no Instagram, gerando antecipação para a data.
          </p>
          <p style="font-size: var(--text-base); line-height: 1.75; color: var(--color-muted);">
            O desafio era produzir 4 reels com identidade visual coesa — que parecesse campanha, não posts avulsos — mantendo variedade suficiente para que cada vídeo tivesse razão de existir individualmente na timeline.
          </p>
        </div>
        <div style="display: flex; flex-direction: column; gap: var(--space-5);">
          <div style="border: var(--border-thick); background: var(--color-surface); box-shadow: var(--shadow-sm); padding: var(--space-5);">
            <p class="section-label" style="margin-bottom: var(--space-2);">Contexto</p>
            <p style="font-size: var(--text-sm); line-height: 1.6; color: var(--color-muted);">
              Mobifans — campanha de Dia dos Namorados. 4 vídeos publicados entre 05 e 11 de junho de 2026, com intervalo de 2 dias entre cada publicação.
            </p>
          </div>
          <div style="border: var(--border-thick); background: var(--color-surface); box-shadow: var(--shadow-sm); padding: var(--space-5);">
            <p class="section-label" style="margin-bottom: var(--space-2);">Problema central</p>
            <p style="font-size: var(--text-sm); line-height: 1.6; color: var(--color-muted);">
              Criar uma campanha audiovisual com produção e identidade visual próprias, usando os produtos Mobifans como protagonistas — captação, edição e motion em um fluxo contínuo.
            </p>
          </div>
          <div style="border: var(--border-thick); background: var(--color-yellow); box-shadow: var(--shadow-sm); padding: var(--space-5);">
            <p class="section-label" style="margin-bottom: var(--space-2); color: var(--color-ink);">Oportunidade</p>
            <p style="font-size: var(--text-sm); line-height: 1.6; color: var(--color-ink);">
              Campanha seriada — 4 vídeos que constroem antecipação gradual até o dia 12 de junho, com motion graphics que reforçam a identidade de marca em cada peça.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 02 — MEU PAPEL -->
  <section class="case-section" aria-labelledby="papel-title" style="background: var(--color-surface);">
    <div class="container">
      <div class="case-section__header">
        <p class="section-label" id="papel-title" data-en="02 — My Role">02 — Meu Papel</p>
        <span class="case-section__note" data-en="capture · edit · motion">captação · edição · motion</span>
      </div>
      <div class="case-grid-3" data-reveal>
        <div class="role-card">
          <span class="role-card__label" data-en="Responsibility">Responsabilidade</span>
          <h3 class="role-card__title">Captação</h3>
          <p class="role-card__desc" style="text-align: justify;">
            Direção e captação das cenas — iluminação, enquadramento e direção dos takes para o formato vertical 9:16 do reel, com foco nos produtos Mobifans como protagonistas.
          </p>
        </div>
        <div class="role-card">
          <span class="role-card__label" data-en="Responsibility">Responsabilidade</span>
          <h3 class="role-card__title">Edição</h3>
          <p class="role-card__desc" style="text-align: justify;">
            Edição no Premiere Pro — seleção de takes, corte no ritmo da música, correção de cor e tratamento de imagem para manter consistência visual entre os 4 vídeos da campanha.
          </p>
        </div>
        <div class="role-card">
          <span class="role-card__label" data-en="Responsibility">Responsabilidade</span>
          <h3 class="role-card__title">Motion Graphics</h3>
          <p class="role-card__desc" style="text-align: justify;">
            Animações de texto, transições e elementos gráficos no After Effects — reforçando a identidade de marca e criando o fio visual que conecta os 4 vídeos da campanha.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 03 — PROCESSO & SOLUÇÃO -->
  <section class="case-section" aria-labelledby="processo-title">
    <div class="container">
      <div class="case-section__header">
        <p class="section-label" id="processo-title" data-en="03 — Process & Solution">03 — Processo & Solução</p>
        <span class="case-section__note" data-en="script · capture · edit · publish">roteiro · captação · edição · publicação</span>
      </div>

      <div class="case-img-pair" data-reveal>
        <div class="case-img-pair__item">
          <img class="case-img-pair__img" src="/projetos/mobi_namorados/Processo_01.webp" alt="Roteiro e storyboard da campanha" />
          <span class="case-img-pair__caption" data-en="step 01 · script">Passo 01 · Roteiro</span>
        </div>
        <div class="case-img-pair__item">
          <video class="case-img-pair__img"
            src="/projetos/mobi_namorados/Processo_02.webm"
            alt="Setup de captação com produtos Mobifans"
            autoplay muted loop playsinline loading="lazy">
          </video>
          <span class="case-img-pair__caption" data-en="step 02 · filming setup">Passo 02 · Setup de Captação</span>
        </div>
      </div>

      <p class="case-narrative" data-reveal data-reveal-delay="1">
        Cada vídeo da campanha foi planejado como uma peça independente dentro de um arco narrativo de sete dias. O primeiro vídeo (05/06) apresenta os produtos; os do meio desenvolvem o contexto romântico; o último (11/06) finaliza com o CTA direto para a data.
      </p>
      <p class="case-narrative" data-reveal data-reveal-delay="1">
        A decisão de design mais importante foi o <strong>sistema de motion graphics compartilhado</strong> — elementos gráficos reutilizados entre os 4 vídeos (fonte, animação de entrada, paleta) que criam a sensação de campanha sem exigir que o espectador tenha visto os vídeos anteriores para entender o atual.
      </p>

      <div class="case-code" data-reveal data-reveal-delay="2" role="region" aria-label="Especificações de produção e exportação da campanha audiovisual"><span class="tok-comment">// Dia dos Namorados — pipeline audiovisual completo</span>

<span class="tok-keyword">CAPTAÇÃO</span>
  Formato        <span class="tok-string">4K 30fps</span>
  Proporção      <span class="tok-string">9:16 vertical</span>  <span class="tok-comment">nativo para reel</span>
  Publicações    <span class="tok-string">4 reels</span>         <span class="tok-comment">05, 07, 09, 11 jun 2026</span>

<span class="tok-keyword">EDIÇÃO</span>
  Software       <span class="tok-string">Premiere Pro</span>
  Cor            <span class="tok-string">LUT custom</span>      <span class="tok-comment">consistência entre vídeos</span>
  Duração        <span class="tok-string">15–30s</span>          <span class="tok-comment">otimizado para retenção</span>

<span class="tok-keyword">MOTION</span>
  Software       <span class="tok-string">After Effects</span>
  Elementos      <span class="tok-string">compartilhados</span>  <span class="tok-comment">sistema visual de campanha</span>

<span class="tok-keyword">EXPORT</span>
  Codec          <span class="tok-string">H.264 / AAC</span>
  Resolução      <span class="tok-string">1080 × 1920</span>
  Bitrate        <span class="tok-string">10 Mbps</span></div>

      <div class="case-img-large" data-reveal>
        <img class="case-img-large__img" src="/projetos/mobi_namorados/Processo_Large.webp" alt="Frames dos vídeos 05, 07 e 09 de junho" />
        <span class="case-img-pair__caption" data-en="VIDEOS 01, 02 &amp; 03 · JUN 05 · 07 · 09">VÍDEOS 01, 02 &amp; 03 · 05 · 07 · 09 JUN</span>
      </div>

    </div>
  </section>

  <!-- 04 — RESULTADO -->
  <section class="case-section" aria-labelledby="resultado-title" style="background: var(--color-surface);">
    <div class="container">
      <div class="case-section__header">
        <p class="section-label" id="resultado-title" data-en="04 — Result">04 — Resultado</p>
        <span class="case-section__note" data-en="published · live on Instagram">publicado · ao vivo no Instagram</span>
      </div>
      <div class="case-resultado" data-reveal>
        <div>
          <div class="metric-cards">
            <div class="metric-card metric-card--accent">
              <p class="metric-card__number">4</p>
              <p class="metric-card__label" data-en="Videos published">Vídeos publicados</p>
            </div>
            <div class="metric-card metric-card--plain">
              <p class="metric-card__number">7 dias</p>
              <p class="metric-card__label" data-en="Campaign duration">Duração da campanha</p>
            </div>
          </div>
          <p class="case-resultado__impact">
            <strong>Campanha audiovisual completa entregue e publicada.</strong> 4 reels produzidos do zero — captação, edição e motion — e publicados ao longo de 7 dias no Instagram da Mobifans, cobrindo a semana do Dia dos Namorados. Ver ao vivo:
          </p>
          <div class="video-timeline">
            <a class="video-item" href="https://www.instagram.com/mobifans/reel/DKiBqyfOnex/" target="_blank" rel="noopener noreferrer">
              <span class="video-item__date">05 Jun</span>
              <span class="video-item__title">Vídeo 01 · Reel Instagram</span>
              <span class="video-item__arrow">↗</span>
            </a>
            <a class="video-item" href="https://www.instagram.com/mobifans/reel/DKmaURxO689/" target="_blank" rel="noopener noreferrer">
              <span class="video-item__date">07 Jun</span>
              <span class="video-item__title">Vídeo 02 · Reel Instagram</span>
              <span class="video-item__arrow">↗</span>
            </a>
            <a class="video-item" href="https://www.instagram.com/mobifans/reel/DKsRExRuG4L/" target="_blank" rel="noopener noreferrer">
              <span class="video-item__date">09 Jun</span>
              <span class="video-item__title">Vídeo 03 · Reel Instagram</span>
              <span class="video-item__arrow">↗</span>
            </a>
            <a class="video-item" href="https://www.instagram.com/mobifans/reel/DKxdp23O74v/" target="_blank" rel="noopener noreferrer">
              <span class="video-item__date">11 Jun</span>
              <span class="video-item__title">Vídeo 04 · Reel Instagram</span>
              <span class="video-item__arrow">↗</span>
            </a>
          </div>
        </div>
        <div>
          <video class="case-resultado__screenshot"
                 src="/projetos/mobi_namorados/Processo_3.webm"
                 poster="/projetos/mobi_namorados/Processo_Large.webp"
                 autoplay muted loop playsinline
                 aria-label="Vídeo da campanha Dia dos Namorados Mobifans">
            <img src="/projetos/mobi_namorados/Processo_Large.webp" alt="Frame da campanha Dia dos Namorados Mobifans" />
          </video>
        </div>
      </div>
    </div>
  </section>

  <!-- PRÓXIMO CASE -->
  <section class="case-next" aria-label="Próximo case">
    <div class="container">
      <a href="mobi_placas.html" class="case-next__card" data-reveal>
        <div>
          <p class="case-next__label" data-en="Next case →">Próximo case →</p>
          <p class="case-next__title">Placas Wallets<br />&amp; Crossbody.</p>
        </div>
        <img class="case-next__thumb" src="/projetos/mobi_placas/Banner_PlacasQuiosque_21_9.webp" alt="Thumbnail Placas Wallets Crossbody" loading="lazy" />
        <span class="case-next__arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </section>

</CaseStudy>
