---
import CaseStudy from '../../layouts/CaseStudy.astro';
---

<CaseStudy
  caseTitle="Projeto Vivências"
  caseDesc="Identidade visual desenvolvida para a colaboração do UniSenac com a RBS TV. Desenvolvido por alunos de Produção Multimídia."
  casePath="/projetos/unisenac_vivencias.html"
  ogImage="/projetos/unisenac_vivencias/Banner_Vivencias_21_9.webp"
  heroImageHref="/projetos/unisenac_vivencias/Banner_Vivencias_21_9.webp"
>

  <!-- BREADCRUMB -->
  <div class="case-breadcrumb">
    <div class="container case-breadcrumb__inner">
      <a class="case-breadcrumb__link" href="../projetos.html" data-en="← Projects">← Projetos</a>
      <span class="case-breadcrumb__sep">·</span>
      <span class="case-breadcrumb__current" data-en="Case">Case</span>
    </div>
  </div>

  <!-- CASE HEADER -->
  <section class="case-header" aria-labelledby="case-title">
    <div class="container">
      <p class="case-header__eyebrow" data-en="Case · Brand Identity · UniSenac + RBS TV">
        Case · Identidade Visual · UniSenac + RBS TV
      </p>
      <h1 class="case-header__title" id="case-title">
        Projeto<br />Vivências.
      </h1>
      <div class="case-header__meta">
        <span class="case-header__date" data-en="Sep 2023 → Nov 2023">Set 2023 → Nov 2023</span>
        <div class="case-header__tags">
          <span class="tech-tag">Figma</span>
          <span class="tech-tag">Identidade Visual</span>
          <span class="tech-tag">Branding</span>
          <span class="tech-tag">Motion Design</span>
          <span class="tech-tag">UniSenac</span>
          <span class="tech-tag">RBS TV</span>
        </div>
      </div>
    </div>
  </section>

  <!-- HERO DO CASE -->
  <div class="case-hero" role="img" aria-label="Banner do Projeto Vivências">
    <img class="case-hero__img" src="/projetos/unisenac_vivencias/Banner_Vivencias_21_9.webp"
      alt="Banner do Projeto Vivências — identidade visual UniSenac + RBS TV"
      width="2100" height="900" loading="eager" />
  </div>

  <!-- 01 — CONTEXTO / PROBLEMA -->
  <section class="case-section" aria-labelledby="ctx-title">
    <div class="container">
      <div class="case-section__header">
        <p class="section-label" id="ctx-title" data-en="01 — Context / Problem">01 — Contexto / Problema</p>
        <span class="case-section__note" data-en="academic collaboration · real project">colaboração acadêmica · projeto real</span>
      </div>
      <div class="case-grid-2" data-reveal>
        <div>
          <p style="font-size: var(--text-base); line-height: 1.75; color: var(--color-muted); margin-bottom: var(--space-6);">
            O <strong style="color: var(--color-ink);">Projeto Vivências</strong> nasceu de uma colaboração entre o UniSenac e a RBS TV, idealizada pela professora e coordenadora do curso de Produção Multimídia, Fabrizzia Lacerda. A proposta era simples e ambiciosa ao mesmo tempo: colocar alunos do curso para produzir conteúdo real para a maior emissora de TV do Sul do Brasil.
          </p>
          <p style="font-size: var(--text-base); line-height: 1.75; color: var(--color-muted);">
            Antes de gravar o primeiro frame, o projeto precisava de uma identidade. Uma marca que representasse essa fusão — o rigor acadêmico do UniSenac e a linguagem visual dinâmica da RBS TV — e que fosse forte o suficiente para aparecer na televisão.
          </p>
        </div>
        <div style="display: flex; flex-direction: column; gap: var(--space-5);">
          <div style="border: var(--border-thick); background: var(--color-surface); box-shadow: var(--shadow-sm); padding: var(--space-5);">
            <p class="section-label" style="margin-bottom: var(--space-2);" data-en="Context">Cliente / Contexto</p>
            <p style="font-size: var(--text-sm); line-height: 1.6; color: var(--color-muted);">
              UniSenac Porto Alegre + RBS TV — colaboração entre instituto de ensino superior e emissora de TV regional, liderada pela professora coordenadora Fabrizzia Lacerda.
            </p>
          </div>
          <div style="border: var(--border-thick); background: var(--color-surface); box-shadow: var(--shadow-sm); padding: var(--space-5);">
            <p class="section-label" style="margin-bottom: var(--space-2);" data-en="Core problem">Problema central</p>
            <p style="font-size: var(--text-sm); line-height: 1.6; color: var(--color-muted);">
              Criar uma identidade visual do zero capaz de representar a parceria acadêmico-televisiva e ser veiculada com credibilidade em uma emissora de TV.
            </p>
          </div>
          <div style="border: var(--border-thick); background: var(--color-yellow); box-shadow: var(--shadow-sm); padding: var(--space-5);">
            <p class="section-label" style="margin-bottom: var(--space-2);" data-en="Opportunity">Oportunidade</p>
            <p style="font-size: var(--text-sm); line-height: 1.6; color: var(--color-ink);">
              Desenvolver uma marca em contexto real — com exigência e visibilidade de TV — enquanto ainda era estudante. E participar da 1ª Edição como um dos primeiros criadores do programa.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 02 — MEU PAPEL -->
  <section class="case-section" aria-labelledby="papel-title" style="background: var(--color-surface);">
    <div class="container">
      <div class="case-section__header">
        <p class="section-label" id="papel-title" data-en="02 — My Role">02 — Meu Papel</p>
        <span class="case-section__note" data-en="what I was responsible for">o que eu entregava</span>
      </div>
      <div class="case-grid-3" data-reveal>
        <div class="role-card">
          <span class="role-card__label" data-en="Responsibility">Responsabilidade</span>
          <h3 class="role-card__title" data-en="Brand Identity">Identi<br>dade visual</h3>
          <p class="role-card__desc" data-en="Creation of the visual system: logo, color palette, typography, and brand guidelines for the collaboration between UniSenac and RBS TV.">
            Criação do sistema visual: logotipo, paleta de cores, tipografia e diretrizes da marca para a colaboração UniSenac + RBS TV.
          </p>
        </div>
        <div class="role-card">
          <span class="role-card__label" data-en="Responsibility">Responsabilidade</span>
          <h3 class="role-card__title" data-en="Team Lead">Equipe</h3>
          <p class="role-card__desc" data-en="Led a team of 8 Multimedia Production students.">
            Coordenação de uma equipe de 8 alunos de Produção Multimídia: Alice Kuch, Gustavo Fernandes, Luka Lacerda, Maria Faria, Manuela Fachel, Magnus Ciarlo e Sabrina Senn.
          </p>
        </div>
        <div class="role-card">
          <span class="role-card__label" data-en="Responsibility">Responsabilidade</span>
          <h3 class="role-card__title" data-en="Production">Produção</h3>
          <p class="role-card__desc" data-en="One of the first to participate in the 1st Edition of Projeto Vivências — from brand creation through on-screen content production.">
            Um dos primeiros a participar da 1ª Edição do Projeto Vivências — da criação da marca até a produção de conteúdo veiculado na emissora.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 03 — PROCESSO & SOLUÇÃO -->
  <section class="case-section" aria-labelledby="processo-title">
    <div class="container">
      <div class="case-section__header">
        <p class="section-label" id="processo-title" data-en="03 — Process & Solution">03 — Processo & Solução</p>
        <span class="case-section__note" data-en="research · concept · brand system">pesquisa · conceito · sistema de marca</span>
      </div>

      <div class="case-img-pair" data-reveal>
        <div class="case-img-pair__item">
          <img class="case-img-pair__img" src="/projetos/unisenac_vivencias/Processo_01.webp"
               alt="Pesquisa e moodboard do Projeto Vivências" loading="lazy" />
          <span class="case-img-pair__caption" data-en="step 01 · research + moodboard">Passo 01 · Pesquisa + Moodboard</span>
        </div>
        <div class="case-img-pair__item">
          <img class="case-img-pair__img" src="/projetos/unisenac_vivencias/Processo_02.webp"
               alt="Sistema de identidade visual finalizado do Projeto Vivências" loading="lazy" />
          <span class="case-img-pair__caption" data-en="step 02 · brand system">Passo 02 · Sistema de Marca</span>
        </div>
      </div>

      <p class="case-narrative" data-reveal data-reveal-delay="1">
        O maior desafio era criar uma identidade que equilibrasse dois mundos com estéticas distintas.
        <strong>UniSenac</strong> trazia o peso institucional de um centro universitário; <strong>RBS TV</strong> trazia a agilidade e o apelo visual da televisão aberta. A solução foi encontrar o ponto de encontro entre as duas — uma marca que soasse profissional o bastante para uma emissora e acessível o bastante para representar estudantes em formação.
      </p>

      <div class="case-img-trio" data-reveal>
        <div>
          <img class="case-img-trio__img" src="/projetos/unisenac_vivencias/Processo_03.webp"
               alt="Logotipo do Projeto Vivências" loading="lazy" />
          <span class="case-img-pair__caption" style="display:block; margin-top: var(--space-3);" data-en="logo · final version">Logotipo · versão final</span>
        </div>
        <div>
          <img class="case-img-trio__img" src="/projetos/unisenac_vivencias/Processo_04.webp"
               alt="Paleta de cores e tipografia do Projeto Vivências" loading="lazy" />
          <span class="case-img-pair__caption" style="display:block; margin-top: var(--space-3);" data-en="colors + type">Cores + Tipografia</span>
        </div>
        <div>
          <img class="case-img-trio__img" src="/projetos/unisenac_vivencias/Processo_05.webp"
               alt="Aplicação da marca do Projeto Vivências em vinheta de TV" loading="lazy" />
          <span class="case-img-pair__caption" style="display:block; margin-top: var(--space-3);" data-en="Team Sketchs">Rascunhos da equipe</span>
        </div>
      </div>

    </div>
  </section>

  <!-- 04 — RESULTADO -->
  <section class="case-section" aria-labelledby="resultado-title" style="background: var(--color-surface);">
    <div class="container">
      <div class="case-section__header">
        <p class="section-label" id="resultado-title" data-en="04 — Result">04 — Resultado</p>
        <span class="case-section__note" data-en="real brand · broadcast-ready">marca real · veiculada na TV</span>
      </div>
      <div class="case-resultado" data-reveal>
        <div>
          <div class="metric-cards">
            <div class="metric-card metric-card--accent">
              <p class="metric-card__number">8</p>
              <p class="metric-card__label" data-en="Designers on the team">Designers na equipe</p>
            </div>
            <div class="metric-card metric-card--plain">
              <p class="metric-card__number">1ª Ed.</p>
              <p class="metric-card__label" data-en="Announced Sep 2023">Anunciada Set 2023</p>
            </div>
          </div>
          <p class="case-resultado__impact">
            <strong>Uma identidade criada do zero em contexto acadêmico — e levada ao ar na RBS TV.</strong> Desenvolvida por uma equipe de 8 alunos de Produção Multimídia, aprovada pela instituição e anunciada como a face da 1ª edição do programa. O Vivências segue acontecendo — este case é sobre o que foi construído no começo.
          </p>
          <div class="projeto__actions">
            <a href="https://www.instagram.com/unisenacrs/p/CxGJi5fONN-/" target="_blank" rel="noopener noreferrer" class="btn btn--primary"
              data-en="See 1st edition announcement ↗">Ver anúncio da 1ª edição ↗</a>
          </div>
          <p style="margin-top: var(--space-6); font-family: var(--font-mono); font-size: var(--text-xs); color: var(--color-muted); line-height: 1.7;">
            O programa segue em atividade —
            <a href="https://www.senacrs.com.br/noticiadetalhe/2026/04/29/unisenac-porto-alegre-lanca-inscricoes-para-nova-edicao-do-programa-vivencias-rbs/8827a3f8-778e-42eb-8cd8-9983866db364"
              target="_blank" rel="noopener noreferrer"
              style="color: var(--color-muted); text-decoration: underline;"
              data-en="6th edition, April 2026 ↗">6ª edição, abril de 2026 ↗</a>
          </p>
        </div>
        <div>
          <img class="case-resultado__screenshot" src="/projetos/unisenac_vivencias/Processo_06.webp"
               alt="Demonstrativo do Projeto Vivências aplicado em vinheta de TV"
               width="800" height="600" loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <!-- PRÓXIMO CASE -->
  <section class="case-next" aria-label="Próximo case">
    <div class="container">
      <a href="cavaleiro_de_latao.html" class="case-next__card" data-reveal>
        <div>
          <p class="case-next__label" data-en="Next case →">Próximo case →</p>
          <p class="case-next__title" data-en="Cavaleiro<br />de Latão.">Cavaleiro<br />de Latão.</p>
        </div>
        <img class="case-next__thumb" src="/projetos/cavaleiro_de_latao/Banner_Cavaleiro_21_9.webp" alt="Thumbnail Cavaleiro de Latão" loading="lazy" />
        <span class="case-next__arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </section>

</CaseStudy>
