---
import CaseStudy from '../../layouts/CaseStudy.astro';
---

<CaseStudy
  caseTitle="Serra Gaúcha — Raiz e Colheita"
  caseDesc="Serra Gaúcha — Raiz e Colheita — identidade visual territorial para o Concurso de Criação da Marca SERRA GAÚCHA (G30): logotipo, manual de identidade visual e aplicações para 49 municípios."
  casePath="/projetos/serra_gaucha.html"
  ogImage="/projetos/serra_gaucha/Banner_portfolio.png"
  heroImageHref="/projetos/serra_gaucha/Banner_portfolio.png"
>

  <Fragment slot="head-extra">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&family=Fraunces:ital,wght@0,600;0,700&family=Outfit:wght@400;600&display=swap" rel="stylesheet" />
  </Fragment>

  <div class="serra-gaucha-page">

  <!-- BREADCRUMB -->
  <div class="case-breadcrumb">
    <div class="container case-breadcrumb__inner">
      <a class="case-breadcrumb__link" href="../projetos.html" data-en="← Projects">← Projetos</a>
      <span class="case-breadcrumb__sep">·</span>
      <span class="case-breadcrumb__current" data-en="Case">Case</span>
    </div>
  </div>

  <!-- CASE HEADER -->
  <section class="case-header" aria-labelledby="case-title">
    <div class="container">
      <p class="case-header__eyebrow" data-en="Case · Branding · Territory · G30 Contest">
        Case · Branding · Território · Concurso G30
      </p>
      <h1 class="case-header__title" id="case-title">
        Serra Gaúcha<br />Raiz e Colheita.
      </h1>
      <div class="case-header__meta">
        <span class="case-header__date" data-en="2026">2026</span>
        <div class="case-header__tags">
          <span class="tech-tag">Figma</span>
          <span class="tech-tag" data-en="Territorial Branding">Branding Territorial</span>
          <span class="tech-tag" data-en="Visual Identity">Identidade Visual</span>
          <span class="tech-tag" data-en="Brand Manual">Manual de Marca</span>
        </div>
      </div>
    </div>
  </section>

  <!-- HERO DO CASE -->
  <div class="case-hero" role="img" aria-label="Key Visual da marca Serra Gaúcha — Raiz e Colheita">
    <img class="case-hero__img" src="/projetos/serra_gaucha/Banner_portfolio.png"
         alt="Key Visual da marca Serra Gaúcha — Raiz e Colheita" width="1618" height="694" loading="eager" />
  </div>

  <!-- 01 — CONTEXTO / BRIEFING -->
  <section class="case-section" aria-labelledby="ctx-title">
    <div class="container">
      <div class="case-section__header">
        <p class="section-label" id="ctx-title" data-en="01 — Context / Briefing">01 — Contexto / Briefing</p>
        <span class="case-section__note" data-en="G30 · 49 municipalities · 17-day sprint">G30 · 49 municípios · sprint de 17 dias</span>
      </div>
      <div class="case-grid-2" data-reveal>
        <div>
          <p style="font-size: var(--text-base); line-height: 1.75; color: var(--color-muted); margin-bottom: var(--space-6);" data-en="The G30 opened a public contest for the creation of the official brand of Serra Gaúcha, a Brazilian tourism and production region made up of 49 municipalities with very different economies — wine, mountain tourism, cheese, furniture, flowers. The regulation asked for a complete visual identity: logotype, brand manual and a conceptual defense, submitted within 17 days.">
            O G30 abriu um <strong style="color: var(--color-ink);">concurso público</strong> para a criação da marca oficial da Serra Gaúcha, região turística e produtiva formada por <strong style="color: var(--color-ink);">49 municípios</strong> com economias bem diferentes entre si, vinho, turismo de montanha, queijo, móveis, flores. O regulamento pedia uma identidade visual completa: logotipo, manual de identidade e defesa conceitual, entregues em <strong style="color: var(--color-ink);">17 dias</strong>.
          </p>
          <p style="font-size: var(--text-base); line-height: 1.75; color: var(--color-muted); margin-bottom: var(--space-6);" data-en="The briefing set 4 pillars the brand needed to serve at once: unify a fragmented territorial identity, protect it legally as a reputation asset, promote it for tourism, and let small producers monetize it as a seal on their own products.">
            O briefing definia <strong style="color: var(--color-ink);">4 pilares</strong> que a marca precisava servir ao mesmo tempo: unificar uma identidade territorial fragmentada, protegê-la juridicamente como ativo de reputação, promovê-la turisticamente e permitir que pequenos produtores a monetizem como selo em seus próprios produtos.
          </p>
          <p style="font-size: var(--text-base); line-height: 1.75; color: var(--color-muted);" data-en="Before opening any design tool, I spent the first day planning the 17 days into phases — research, concept, visual construction, refinement, delivery — to avoid the real risk of a tight deadline: exploring without knowing when to stop.">
            Antes de abrir qualquer ferramenta de design, passei o primeiro dia planejando os 17 dias em fases: <strong style="color: var(--color-ink);">pesquisa, conceito, construção visual, refinamento, entrega</strong>. Para evitar o risco real de um prazo apertado: explorar sem saber quando parar.
          </p>
        </div>
        <div style="display: flex; flex-direction: column; gap: var(--space-5);">
          <div style="border: var(--border-thick); background: var(--color-surface); box-shadow: var(--shadow-sm); padding: var(--space-5);">
            <p class="section-label" style="margin-bottom: var(--space-2);" data-en="Context">Contexto</p>
            <p style="font-size: var(--text-sm); line-height: 1.6; color: var(--color-muted);" data-en="Concurso de Criação da Marca SERRA GAÚCHA, promoted by the G30. Goal: an official territorial brand usable across tourism, agribusiness and institutional communication for 49 municipalities.">
              Concurso de Criação da Marca SERRA GAÚCHA, promovido pelo G30. Objetivo: marca territorial oficial aplicável em turismo, agronegócio e comunicação institucional para 49 municípios.
            </p>
          </div>
          <div style="border: var(--border-thick); background: var(--color-surface); box-shadow: var(--shadow-sm); padding: var(--space-5);">
            <p class="section-label" style="margin-bottom: var(--space-2);" data-en="Core challenge">Problema central</p>
            <p style="font-size: var(--text-sm); line-height: 1.6; color: var(--color-muted);" data-en="49 municipalities, 3 microregions and multiple economies inside a single symbol — without excluding any of them or reducing the region to the most obvious industry (wine).">
              49 municípios, 3 microrregiões e múltiplas economias dentro de um único símbolo sem excluir nenhuma delas nem reduzir a região à indústria mais óbvia (o vinho).
            </p>
          </div>
          <div style="border: var(--border-thick); background: var(--color-yellow); box-shadow: var(--shadow-sm); padding: var(--space-5);">
            <p class="section-label" style="margin-bottom: var(--space-2); color: var(--color-ink);" data-en="Direction">Direção</p>
            <p style="font-size: var(--text-sm); line-height: 1.6; color: var(--color-ink);" data-en="'Raiz e Colheita' (Root and Harvest): a symbol built on what every municipality has in common before producing anything — the land and the gesture of cultivating it — instead of the industry each one is known for.">
              "Raiz e Colheita": um símbolo construído sobre o que todo município tem em comum antes de produzir qualquer coisa: a terra e o gesto de cultivá-la em vez da indústria pela qual cada um é conhecido.
            </p>
          </div>
        </div>
      </div>

      <div class="territory-map" data-reveal aria-label="Mapa interativo dos municípios da Serra Gaúcha">
        <p class="territory-map__title" data-en="49 municipalities, 3 microregions">49 municípios, 3 microrregiões</p>
        <div class="territory-map__body">
          <div class="territory-map__figure">
            <div class="territory-map__svg" id="territory-svg"></div>
          </div>
          <div class="territory-map__panel">
            <div class="territory-map__legend" role="list">
              <button type="button" class="territory-legend__item" data-region="uva-e-vinho" role="listitem">
                <span class="territory-legend__swatch"></span>
                <span data-en="Wine and Grape">Uva e Vinho</span>
              </button>
              <button type="button" class="territory-legend__item" data-region="hortensias" role="listitem">
                <span class="territory-legend__swatch"></span>
                <span data-en="Hortênsias">Hortênsias</span>
              </button>
              <button type="button" class="territory-legend__item" data-region="campos-de-cima" role="listitem">
                <span class="territory-legend__swatch"></span>
                <span data-en="Highland Fields">Campos de Cima da Serra</span>
              </button>
            </div>
            <div class="territory-map__info" id="territory-info">
              <p class="territory-map__hint" data-en="Hover or tap a municipality on the map.">Passe o mouse ou toque em um município no mapa.</p>
            </div>
          </div>
        </div>
      </div>

      <script>
        (function () {
          const svgHost = document.getElementById('territory-svg');
          const info = document.getElementById('territory-info');
          const legendItems = document.querySelectorAll('.territory-legend__item');
          if (!svgHost || !info) return;

          const REGION_LABEL = {
            'uva-e-vinho': 'Uva e Vinho',
            'hortensias': 'Hortênsias',
            'campos-de-cima': 'Campos de Cima da Serra',
          };
          const REGION_DESC = {
            'uva-e-vinho': 'A maior produção de vinho do Brasil. Bento Gonçalves, Caxias do Sul e Garibaldi estão aqui — os municípios que dão nome à combinação uva e vinho.',
            'hortensias': 'Hotéis de montanha e clima frio. Gramado, Canela e Nova Petrópolis, batizada pelas flores que enfeitam as ruas dessas cidades.',
            'campos-de-cima': 'Pradarias de altitude e os cânions do Aparados da Serra. Vacaria, Cambará do Sul e São José dos Ausentes: a parte mais alta e fria da Serra Gaúcha.',
          };

          function showInfo(name, region) {
            info.innerHTML = '<p class="territory-map__muni-name">' + name + '</p>' +
              '<p class="territory-map__muni-region">' + REGION_LABEL[region] + '</p>' +
              '<p class="territory-map__muni-desc">' + REGION_DESC[region] + '</p>';
          }

          function resetInfo() {
            info.innerHTML = '<p class="territory-map__hint">Passe o mouse ou toque em um município no mapa.</p>';
          }

          fetch('/projetos/serra_gaucha/mapa-municipios.svg')
            .then((r) => r.text())
            .then((svgText) => {
              svgHost.innerHTML = svgText;
              const paths = svgHost.querySelectorAll('.map-muni');

              paths.forEach((path) => {
                const name = path.dataset.name;
                const region = path.dataset.region;
                path.addEventListener('mouseenter', () => showInfo(name, region));
                path.addEventListener('focus', () => showInfo(name, region));
                path.addEventListener('click', () => {
                  paths.forEach((p) => p.classList.remove('is-active'));
                  path.classList.add('is-active');
                  showInfo(name, region);
                });
              });

              svgHost.addEventListener('mouseleave', () => {
                const active = svgHost.querySelector('.map-muni.is-active');
                if (active) showInfo(active.dataset.name, active.dataset.region);
                else resetInfo();
              });

              legendItems.forEach((item) => {
                item.addEventListener('click', () => {
                  const region = item.dataset.region;
                  const isActive = item.classList.contains('is-active');
                  legendItems.forEach((li) => li.classList.remove('is-active'));
                  paths.forEach((p) => p.classList.remove('is-dimmed'));
                  if (!isActive) {
                    item.classList.add('is-active');
                    paths.forEach((p) => {
                      if (p.dataset.region !== region) p.classList.add('is-dimmed');
                    });
                  }
                });
              });
            });
        })();
      </script>

      <style>
        .territory-map { margin-top: var(--space-10); }
        .territory-map__title { font-family: var(--font-mono); font-size: var(--text-xs); font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--color-muted); margin-bottom: var(--space-4); }
        .territory-map__body { display: grid; grid-template-columns: 1fr; gap: var(--space-6); }
        @media (min-width: 800px) { .territory-map__body { grid-template-columns: 2fr 1fr; gap: var(--space-8); align-items: start; } }
        .territory-map__figure { border: var(--border-thick); background: #F2EFF8; box-shadow: var(--shadow-md); }
        .territory-map__svg { width: 100%; line-height: 0; }
        .territory-map__svg :global(svg) { width: 100%; height: auto; display: block; }
        .territory-map__svg :global(.map-muni) { fill: var(--muni-color, #8C5A3C); stroke: #F2EFF8; stroke-width: 0.8; cursor: pointer; transition: fill 0.15s ease, opacity 0.15s ease; outline: none; }
        .territory-map__svg :global(.map-muni[data-region="uva-e-vinho"]) { --muni-color: #8C5A3C; }
        .territory-map__svg :global(.map-muni[data-region="hortensias"]) { --muni-color: #5C7A63; }
        .territory-map__svg :global(.map-muni[data-region="campos-de-cima"]) { --muni-color: #2E4634; }
        .territory-map__svg :global(.map-muni:hover),
        .territory-map__svg :global(.map-muni:focus-visible),
        .territory-map__svg :global(.map-muni.is-active) { fill: var(--color-yellow); stroke: #262420; }
        .territory-map__svg :global(.map-muni.is-dimmed) { opacity: 0.25; }
        .territory-map__svg :global(.map-label) { display: none; }
        .territory-map__legend { display: flex; flex-direction: column; gap: var(--space-2); margin-bottom: var(--space-5); }
        .territory-legend__item { display: flex; align-items: center; gap: var(--space-3); padding: var(--space-2) var(--space-3); border: var(--border); background: var(--color-surface); font-family: var(--font-mono); font-size: var(--text-xs); font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; color: var(--color-muted); transition: var(--transition-fast); text-align: left; }
        .territory-legend__item:hover { color: var(--color-ink); }
        .territory-legend__item.is-active { background: var(--color-yellow); color: var(--color-ink); border-color: var(--color-ink); }
        .territory-legend__swatch { display: block; width: 12px; height: 12px; flex-shrink: 0; border: 1px solid var(--color-ink); }
        .territory-legend__item[data-region="uva-e-vinho"] .territory-legend__swatch { background: #8C5A3C; }
        .territory-legend__item[data-region="hortensias"] .territory-legend__swatch { background: #5C7A63; }
        .territory-legend__item[data-region="campos-de-cima"] .territory-legend__swatch { background: #2E4634; }
        .territory-map__info { border: var(--border-thick); background: var(--color-surface); box-shadow: var(--shadow-sm); padding: var(--space-5); min-height: 140px; }
        .territory-map__hint { font-size: var(--text-sm); color: var(--color-muted); }
        .territory-map__muni-name { font-family: var(--font-display); font-size: var(--text-xl); font-weight: 800; text-transform: uppercase; letter-spacing: -0.02em; margin-bottom: var(--space-1); }
        .territory-map__muni-region { font-family: var(--font-mono); font-size: var(--text-xs); font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--color-muted); margin-bottom: var(--space-3); }
        .territory-map__muni-desc { font-size: var(--text-sm); line-height: 1.6; color: var(--color-muted); }
      </style>
    </div>
  </section>

  <!-- 02 — MEU PAPEL -->
  <section class="case-section" aria-labelledby="papel-title" style="background: var(--color-surface);">
    <div class="container">
      <div class="case-section__header">
        <p class="section-label" id="papel-title" data-en="02 — My Role">02 — Meu Papel</p>
        <span class="case-section__note" data-en="research · concept · identity · manual">pesquisa · conceito · identidade · manual</span>
      </div>
      <div class="case-grid-3" data-reveal>
        <div class="role-card">
          <span class="role-card__label" data-en="Responsibility">Responsabilidade</span>
          <h3 class="role-card__title" data-en="Territorial Research">Pesquisa</h3>
          <p class="role-card__desc" style="text-align: justify;" data-en="Mapping the economic activity of the 49 municipalities and the 3 microregions (Uva e Vinho, Hortênsias, Campos de Cima da Serra), plus a benchmark of place branding references (Switzerland, Alentejo, Basque Country, Denmark) to avoid a generic 'Fake Europa' postcard aesthetic.">
            Mapeamento da atividade econômica dos 49 municípios e das 3 microrregiões (Uva e Vinho, Hortênsias, Campos de Cima da Serra), somado a um benchmark de referências de place branding (Suíça, Alentejo, País Basco, Dinamarca) para evitar a estética genérica de "Fake Europa" em postal.
          </p>
        </div>
        <div class="role-card">
          <span class="role-card__label" data-en="Responsibility">Responsabilidade</span>
          <h3 class="role-card__title" data-en="Concept & Symbol">Símbolo</h3>
          <p class="role-card__desc" style="text-align: justify;" data-en="Development, testing and discarding of multiple creative directions until reaching 'Raiz e Colheita' — including a mentoring-driven pivot late in the process, accepted to avoid a weaker direction that was almost final.">
            Desenvolvimento, teste e descarte de múltiplas direções criativas até chegar em "Raiz e Colheita" incluindo um pivô orientado por mentoria informal, aceito a poucos dias da entrega para não seguir com uma direção mais fraca já quase fechada.
          </p>
        </div>
        <div class="role-card">
          <span class="role-card__label" data-en="Responsibility">Responsabilidade</span>
          <h3 class="role-card__title" data-en="Manual & Applications">Aplica<br>ções</h3>
          <p class="role-card__desc" style="text-align: justify;" data-en="Full brand manual — palette, typography, symbol construction, permitted/forbidden uses — plus 10 example applications across digital, regional product and tourism promotion, and the 457-word conceptual defense.">
            Manual de identidade completo, paleta, tipografia, construção do símbolo, usos permitidos/proibidos. Além de 10 aplicações exemplificadas em digital, produto regional e promoção turística, e a defesa conceitual de 457 palavras.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 03 — PROCESSO & SOLUÇÃO -->
  <section class="case-section" aria-labelledby="processo-title">
    <div class="container">
      <div class="case-section__header">
        <p class="section-label" id="processo-title" data-en="03 — Process & Solution">03 — Processo & Solução</p>
        <span class="case-section__note" data-en="symbol · palette · typography · logo variants">símbolo · paleta · tipografia · variações de logo</span>
      </div>

      <div class="symbol-story" aria-label="Do questionamento ao sistema de marca — a história do símbolo">
        <div class="symbol-story__media">
          <div class="symbol-story__media-inner">
            <img class="symbol-story__img is-active" data-step-img="1" src="/projetos/serra_gaucha/Gralha_02_Guiado por Adrian Eisen Rupp..png" alt="Gralha-azul pousada em uma araucária, com um pinhão no bico" />
            <img class="symbol-story__img" data-step-img="2" src="/projetos/serra_gaucha/Gralha_01_Autor Aquiles Naressi.png" alt="Gralha-azul em voo carregando um pinhão" />
            <img class="symbol-story__img" data-step-img="3" src="/projetos/serra_gaucha/Araucária-1.jpg" alt="Uma única araucária jovem crescendo sozinha em uma encosta" />
            <img class="symbol-story__img" data-step-img="4" src="/projetos/serra_gaucha/Itaimbezinho_-_Parque_Nacional_Aparados_da_Serra_32_Por Germano Roberto Schüür - Obra do próprio, CC BY-SA 3.0, httpscommons.wikimedia.orgwindex.phpcurid=40513902.jpg" alt="Araucárias adultas à beira do Cânion do Itaimbezinho" />
          </div>
        </div>
        <div class="symbol-story__steps">
          <div class="symbol-story__step is-active" data-step="1">
            <span class="symbol-story__step-num">01</span>
            <p data-en="Instead of asking what Serra Gaúcha produces, the research flipped the question: what do all these places have in common before producing anything. Wine, cheese, tourism, furniture — every municipality answers the first question differently. For the second, they all have the same answer: the land.">
              Em vez de perguntar o que a Serra Gaúcha produz, a pesquisa virou a pergunta do avesso: o que todos esses lugares têm em comum antes de produzir qualquer coisa. Vinho, queijo, turismo, móveis cada município responde diferente pra primeira pergunta. Pra segunda, todos respondem igual: a terra.
            </p>
          </div>
          <div class="symbol-story__step" data-step="2">
            <span class="symbol-story__step-num">02</span>
            <p data-en="That answer became a symbol in the gralha-azul. It's the bird that plants the araucária: it buries pinhão seeds to eat later in winter and forgets where it left most of them. Without meaning to, it's the tree's biggest planter.">
              Essa resposta virou símbolo na gralha-azul. É ela quem planta a araucária: enterra pinhões pra comer no inverno e esquece onde deixou boa parte deles. Sem querer, acaba sendo a maior plantadora da árvore.
            </p>
          </div>
          <div class="symbol-story__step" data-step="3">
            <span class="symbol-story__step-num">03</span>
            <p data-en="Where the seed gets forgotten, the tree grows. Root and harvest aren't two separate steps — they're the same cycle, repeating. It works the same for wine, cheese, tourism or furniture, because none of them are named in the symbol.">
              Onde o pinhão fica esquecido, nasce a árvore. Raiz e colheita não são duas etapas separadas, são o mesmo ciclo se repetindo. Funciona igual pra vinho, queijo, turismo ou móveis, porque nenhum deles é citado no símbolo.
            </p>
          </div>
          <div class="symbol-story__step" data-step="4">
            <span class="symbol-story__step-num">04</span>
            <p data-en="That cycle became the base of the system: a palette leaning 60–70% Verde Araucária and Marrom Pinhão, with a support palette for digital and product applications (including a reserved 'Vinho Maduro' red, kept out of institutional pieces). Typography combines Libre Baskerville, Fraunces and Outfit — institutional and literary, but legible day to day.">
              Esse ciclo virou a base do sistema: paleta 60–70% <strong>Verde Araucária</strong> e <strong>Marrom Pinhão</strong>, com uma paleta de apoio para aplicações digitais e de produto (incluindo um vermelho reservado, "Vinho Maduro", mantido fora de peças institucionais). A tipografia combina Libre Baskerville, Fraunces e Outfit um registro institucional e literário, mas legível no dia a dia.
            </p>
          </div>
        </div>
      </div>

      <script>
        (function () {
          const story = document.querySelector('.symbol-story');
          if (!story) return;
          const media = story.querySelector('.symbol-story__media');
          const inner = story.querySelector('.symbol-story__media-inner');
          const steps = Array.from(story.querySelectorAll('.symbol-story__step'));
          const images = story.querySelectorAll('.symbol-story__img');
          const mq = window.matchMedia('(min-width: 800px)');

          function setActive(stepNum) {
            steps.forEach((s) => s.classList.toggle('is-active', s.dataset.step === stepNum));
            images.forEach((img) => img.classList.toggle('is-active', img.dataset.stepImg === stepNum));
            // Mobile: card only starts floating over previous steps once
            // step 01 is left behind — keeps it out of the way while text 01 reads.
            media.classList.toggle('is-pinned', stepNum !== '1');
          }

          const observer = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) setActive(entry.target.dataset.step);
              });
            },
            { rootMargin: '-40% 0px -40% 0px', threshold: 0 }
          );
          steps.forEach((s) => observer.observe(s));

          // Move the media box vertically so it tracks the active step's
          // position inside .symbol-story__steps, instead of sitting frozen
          // at a fixed sticky offset.
          let ticking = false;
          function updateMediaPosition() {
            ticking = false;
            if (!mq.matches) {
              inner.style.transform = '';
              return;
            }
            const mediaRect = media.getBoundingClientRect();
            const travel = media.clientHeight - inner.offsetHeight;
            if (travel <= 0) {
              inner.style.transform = '';
              return;
            }
            const activeStep = steps.find((s) => s.classList.contains('is-active')) || steps[0];
            const stepRect = activeStep.getBoundingClientRect();
            const stepCenter = stepRect.top + stepRect.height / 2;
            const viewportCenter = window.innerHeight / 2;
            const firstTop = steps[0].getBoundingClientRect().top;
            const lastStep = steps[steps.length - 1];
            const lastBottom = lastStep.getBoundingClientRect().top + lastStep.getBoundingClientRect().height;
            const progress = (stepCenter - firstTop) / Math.max(1, lastBottom - firstTop);
            const clamped = Math.min(1, Math.max(0, progress));
            inner.style.transform = 'translateY(' + (clamped * travel).toFixed(1) + 'px)';
          }

          function onScroll() {
            if (ticking) return;
            ticking = true;
            requestAnimationFrame(updateMediaPosition);
          }

          window.addEventListener('scroll', onScroll, { passive: true });
          window.addEventListener('resize', onScroll);
          mq.addEventListener('change', updateMediaPosition);
          updateMediaPosition();
        })();
      </script>

